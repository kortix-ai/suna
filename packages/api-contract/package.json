{
  "name": "@kortix/api-contract",
  "version": "1.0.0",
  "description": "Shared wire-type contract for the Kortix platform API. Zod schemas + inferred TS types describing exactly what apps/api serializes onto the wire \u2014 the single source of truth for clients (SDK, web, mobile) and the OpenAPI docs.",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./secret-relay": "./src/secret-relay.ts",
    "./runtime-relay": "./src/runtime-relay.ts",
    "./transcript": "./src/transcript.ts",
    "./session-log": "./src/session-log/index.ts",
    "./fallback-models": "./src/fallback-models.ts",
    "./egress-shim-rules": "./src/egress-shim-rules.ts",
    "./sandbox-layout": "./src/sandbox-layout.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout ${KORTIX_TEST_TIMEOUT_MS:-15000}"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.0.0"
  }
}
