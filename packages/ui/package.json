{
  "name": "@kortix/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Kortix UI: the shared React component library for apps/web, Kortix Apps and SDK hosts. Tailwind v4 classes, themed by CSS variables.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/components/ui/button.tsx",
    "./dotmatrix-loader.css": "./src/styles/dotmatrix-loader.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./hooks/use-debounce": "./src/hooks/use-debounce.ts",
    "./hooks/use-is-dark": "./src/hooks/use-is-dark.ts",
    "./hooks/use-mobile": "./src/hooks/use-mobile.ts",
    "./hooks/use-proximity-hover": "./src/hooks/use-proximity-hover.ts",
    "./icons/close": "./src/icons/close.tsx",
    "./icons/copy": "./src/icons/copy.tsx",
    "./icons/sidebar-toggle": "./src/icons/sidebar-toggle.tsx",
    "./lib/dotmatrix-core": "./src/lib/dotmatrix-core.tsx",
    "./lib/dotmatrix-hooks": "./src/lib/dotmatrix-hooks.ts",
    "./lib/font-weight": "./src/lib/font-weight.ts",
    "./lib/icon-config": "./src/lib/icon-config.ts",
    "./lib/icon-context": "./src/lib/icon-context.tsx",
    "./lib/portal-root": "./src/lib/portal-root.ts",
    "./lib/springs": "./src/lib/springs.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/z-stack": "./src/lib/z-stack.tsx",
    "./package.json": "./package.json",
    "./providers/ui-provider": "./src/providers/ui-provider.tsx",
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "node ../../scripts/test-guard.mjs \"bun test --isolate\"",
    "gen-exports": "node scripts/gen-exports.mjs",
    "build:styles": "node scripts/build-styles.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "^1.3.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwind-scrollbar-hide": "^2.0.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.2.4"
  }
}
