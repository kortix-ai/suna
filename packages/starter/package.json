{
  "name": "@kortix/starter",
  "version": "1.0.0",
  "description": "Kortix project starter — folder-based template + loader. Used by the API's create-repo path and the kortix CLI's `init` command.",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsgo.tsbuildinfo",
    "test": "bun test --timeout ${KORTIX_TEST_TIMEOUT_MS:-15000}"
  },
  "devDependencies": {
    "@kortix/llm-catalog": "workspace:*",
    "@kortix/manifest-schema": "workspace:*",
    "@types/bun": "^1.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^5.0.0",
    "zod": "4.1.8"
  }
}
