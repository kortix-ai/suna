# Sandbox template "video" (kortix.yaml → sandbox.templates). Kortix adds its runtime layer on top
# (git, ffmpeg, fonts, bun, uv, agent-browser…). Rules: FROM Debian/Ubuntu, no ENTRYPOINT/CMD,
# no COPY (empty build context), nothing on port 8000, no credentials.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Node 22 (HyperFrames needs ≥22), ffmpeg, and the shared libraries headless Chrome needs.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg ffmpeg python3 python3-pip \
      libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libdrm2 libxkbcommon0 libxcomposite1 \
      libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2t64 libpango-1.0-0 libcairo2 libxshmfence1 \
      fonts-noto-color-emoji fonts-noto-core \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Pin the renderer and pre-fetch its Chrome so the first render in a session doesn't download it.
RUN npm install -g hyperframes@0.8.151 \
 && hyperframes browser ensure \
 && chmod -R a+rX /root/.cache 2>/dev/null || true

# Optional local TTS (Kokoro) for free drafts: `yt voice --provider kokoro`.
RUN pip3 install --break-system-packages --no-cache-dir kokoro-onnx soundfile || true
