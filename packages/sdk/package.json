{
  "name": "@kortix/sdk",
  "version": "0.3.0",
  "description": "Official Kortix frontend TypeScript SDK — one typed client for the Kortix API. Unifies project/session lifecycle and live agent streaming behind a single ergonomic Session handle, so web, mobile, and white-label apps never touch the raw HTTP API or the agent runtime's wire protocol.",
  "type": "module",
  "license": "Elastic-2.0",
  "homepage": "https://github.com/kortix-ai/CompanyOS/tree/dev/packages/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kortix-ai/CompanyOS.git",
    "directory": "packages/sdk"
  },
  "keywords": ["kortix", "agent", "sdk", "sessions", "streaming"],
  "sideEffects": false,
  "dependencies": {
    "@kortix/llm-catalog": "workspace:*",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "@openuidev/lang-core": "0.3.1",
    "@tanstack/react-query": "^5.75.2",
    "react": ">=18",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@openuidev/lang-core": { "optional": true },
    "@tanstack/react-query": { "optional": true },
    "react": { "optional": true },
    "zod": { "optional": true }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./genui": "./src/genui/index.ts",
    "./genui/fence": "./src/genui/fence-entry.ts",
    "./genui/react": "./src/genui/react/index.ts",
    "./server": "./src/node/server.ts",
    "./internal/idb-sync-cache": "./src/internal/idb-sync-cache.ts",
    "./internal/diagnostics-store": "./src/internal/diagnostics-store.ts",
    "./internal/managed-storage": "./src/internal/managed-storage.ts",
    "./wire-message-id": "./src/core/session/wire-message-id.ts",
    "./capture-rules": "./src/core/capture/rules.ts",
    "./workspace-search": "./src/workspace-search/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./react": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" },
      "./genui": { "types": "./dist/genui/index.d.ts", "import": "./dist/genui/index.js" },
      "./genui/fence": { "types": "./dist/genui/fence-entry.d.ts", "import": "./dist/genui/fence-entry.js" },
      "./genui/react": { "types": "./dist/genui/react/index.d.ts", "import": "./dist/genui/react/index.js" },
      "./server": { "types": "./dist/node/server.d.ts", "import": "./dist/node/server.js" },
      "./internal/idb-sync-cache": {
        "types": "./dist/internal/idb-sync-cache.d.ts",
        "import": "./dist/internal/idb-sync-cache.js"
      },
      "./internal/diagnostics-store": {
        "types": "./dist/internal/diagnostics-store.d.ts",
        "import": "./dist/internal/diagnostics-store.js"
      },
      "./internal/managed-storage": {
        "types": "./dist/internal/managed-storage.d.ts",
        "import": "./dist/internal/managed-storage.js"
      },
      "./wire-message-id": {
        "types": "./dist/core/session/wire-message-id.d.ts",
        "import": "./dist/core/session/wire-message-id.js"
      },
      "./capture-rules": {
        "types": "./dist/core/capture/rules.d.ts",
        "import": "./dist/core/capture/rules.js"
      },
      "./workspace-search": {
        "types": "./dist/workspace-search/index.d.ts",
        "import": "./dist/workspace-search/index.js"
      }
    },
    "browser": "./dist/kortix.esm.min.js",
    "unpkg": "./dist/kortix.global.js",
    "jsdelivr": "./dist/kortix.global.js",
    "files": ["dist", "README.md"]
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "typecheck": "tsgo --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsgo.tsbuildinfo && tsgo --noEmit -p examples/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsgo-examples.tsbuildinfo",
    "test": "node ../../scripts/test-guard.mjs \"bash scripts/test.sh\"",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "build:bundles": "pnpm run build && tsup",
    "prepublishOnly": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && tsup",
    "smoke:install": "node scripts/smoke-install.mjs"
  },
  "devDependencies": {
    "@openuidev/lang-core": "0.3.1",
    "@tanstack/react-query": "^5.75.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-test-renderer": "^19.2.0",
    "tsc-alias": "^1.8.17",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "zod": "4.6.7"
  }
}
