---
// The left column of each docs page: that page's outline, "On this page",
// grouped as the sidebar config groups it (blume.config.ts). Each entry is an
// in-page `#anchor`, and <blume-toc> (registered by Blume's RootLayout) marks
// the section in view with aria-current="location", the same scrollspy as
// Blume's right-hand outline, which is off (toc: false).
interface Node {
  kind?: string;
  label: string;
  route?: string;
  href?: string;
  children?: Node[];
}
interface Props {
  items: Node[];
  currentRoute: string;
}
const { items, currentRoute } = Astro.props;
// The page a link points at, without the /docs base: "/" or "/developers".
const pageOf = (target: string) => {
  const path = target.split('#')[0].replace(/^\/docs(?=\/|$)/, '').replace(/\/$/, '');
  return path === '' ? '/' : path;
};
const here = pageOf(currentRoute);
const anchor = (node: Node) => {
  const target = node.href ?? node.route ?? '';
  const hash = target.indexOf('#');
  return hash === -1 || pageOf(target) !== here ? null : target.slice(hash);
};
// Only the groups with an entry on this page.
const groups = items.filter((group) => (group.children ?? []).some((node) => anchor(node)));
---

<p class="mb-3 px-2.5 font-semibold text-foreground text-sm">On this page</p>
<blume-toc class="block">
  {
    groups.map((group) => (
      <div class="mt-6 first:mt-0">
        <p class="mb-2 px-2.5 font-medium text-foreground text-sm">{group.label}</p>
        <ul class="m-0 list-none space-y-px p-0">
          {(group.children ?? []).map((node) => {
            const href = anchor(node);
            return href ? (
              <li>
                <a
                  class="block rounded-[0.65rem] px-2.5 py-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground aria-[current=location]:bg-muted aria-[current=location]:font-medium aria-[current=location]:text-foreground"
                  href={href}
                >
                  {node.label}
                </a>
              </li>
            ) : null;
          })}
        </ul>
      </div>
    ))
  }
</blume-toc>
