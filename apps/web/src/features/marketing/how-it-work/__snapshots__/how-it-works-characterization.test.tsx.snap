03a14.145 14.145 0 013.001-4.45 14.113 14.113 0 016.453-3.678.503.503 0 000-.975 13.245 13.245 0 01-2.003-.678z" fill="url(#lobe-icons-gemini-fill-2)"></path><defs><linearGradient gradientUnits="userSpaceOnUse" id="lobe-icons-gemini-fill-0" x1="7" x2="11" y1="15.5" y2="12"><stop stop-color="#08B962"></stop><stop offset="1" stop-color="#08B962" stop-opacity="0"></stop></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="lobe-icons-gemini-fill-1" x1="8" x2="11.5" y1="5.5" y2="11"><stop stop-color="#F94543"></stop><stop offset="1" stop-color="#F94543" stop-opacity="0"></stop></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="lobe-icons-gemini-fill-2" x1="3.5" x2="17.5" y1="13.5" y2="12"><stop stop-color="#FABC12"></stop><stop offset=".46" stop-color="#FABC12" stop-opacity="0"></stop></linearGradient></defs></svg></span><span class="min-w-0"><span class="text-foreground block truncate text-[13px] leading-tight font-medium">Google</span><span class="text-muted-foreground block truncate text-[11px] leading-tight">Gemini Pro · Flash</span></span></div><div class="border-border bg-background flex items-center gap-2.5 rounded-md border px-3 py-2"><span class="text-muted-foreground flex size-5 shrink-0 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-4"><path d="M128,24h0A104,104,0,1,0,232,128,104.12,104.12,0,0,0,128,24Zm88,104a87.61,87.61,0,0,1-3.33,24H174.16a157.44,157.44,0,0,0,0-48h38.51A87.61,87.61,0,0,1,216,128ZM102,168H154a115.11,115.11,0,0,1-26,45A115.27,115.27,0,0,1,102,168Zm-3.9-16a140.84,140.84,0,0,1,0-48h59.88a140.84,140.84,0,0,1,0,48ZM40,128a87.61,87.61,0,0,1,3.33-24H81.84a157.44,157.44,0,0,0,0,48H43.33A87.61,87.61,0,0,1,40,128ZM154,88H102a115.11,115.11,0,0,1,26-45A115.27,115.27,0,0,1,154,88Zm52.33,0H170.71a135.28,135.28,0,0,0-22.3-45.6A88.29,88.29,0,0,1,206.37,88ZM107.59,42.4A135.28,135.28,0,0,0,85.29,88H49.63A88.29,88.29,0,0,1,107.59,42.4ZM49.63,168H85.29a135.28,135.28,0,0,0,22.3,45.6A88.29,88.29,0,0,1,49.63,168Zm98.78,45.6a135.28,135.28,0,0,0,22.3-45.6h35.66A88.29,88.29,0,0,1,148.41,213.6Z"></path></svg></span><span class="min-w-0"><span class="text-foreground block truncate text-[13px] leading-tight font-medium">Your endpoint</span><span class="text-muted-foreground block truncate text-[11px] leading-tight">anything OpenAI-compatible</span></span></div></div></div></div></div></div></article><article data-stack-layer="harness" class="border-border bg-popover flex flex-col overflow-hidden rounded-xl border"><div class="flex w-full items-center gap-3 px-4 py-2 sm:px-6"><span class="text-muted-foreground/60 font-mono text-[11px] tracking-widest tabular-nums">04</span><h3 class="text-foreground truncate text-[15px] font-medium tracking-tight sm:text-base">The part that turns a model into an agent.</h3></div><div class="border-border bg-muted/40 dark:bg-muted/15 border-t p-2 flex flex-col gap-3"><div class="flex min-w-0 flex-col gap-2.5 px-2 pt-2"><p class="text-muted-foreground text-[13px] leading-relaxed">A model on its own answers. The harness gives it planning, tool use and multi-step runs it actually finishes — powered by OpenCode, configured by a file in the repo.</p><ul class="text-muted-foreground space-y-1.5 text-[12.5px] leading-relaxed"><li class="flex gap-2"><div class="relative flex shrink-0 items-center justify-center mt-0 size-4"><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-10" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.2000000000000002s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-20 rotate-90" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.2800000000000002s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-30 rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.36s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-40 -rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.4400000000000002s"></div></div><span>An OpenCode agent: markdown, plus the tools and plugins beside it</span></li><li class="flex gap-2"><div class="relative flex shrink-0 items-center justify-center mt-0 size-4"><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-10" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.2000000000000002s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-20 rotate-90" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.2800000000000002s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-30 rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.36s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-40 -rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.4400000000000002s"></div></div><span>Say allow, ask or deny per tool — down to a single shell command</span></li><li class="flex gap-2"><div class="relative flex shrink-0 items-center justify-center mt-0 size-4"><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-10" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.2000000000000002s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-20 rotate-90" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.2800000000000002s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-30 rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.36s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-40 -rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.4400000000000002s"></div></div><span>Open source, so the harness is never the thing you are locked into</span></li></ul></div><div class="flex h-[16rem] min-h-0 w-full flex-col sm:h-[19rem]"><div class="flex h-full min-h-0 w-full flex-col overflow-hidden"><div class="hidden h-full grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:grid"><div class="flex min-w-0 flex-col gap-3 px-7 py-7" style="opacity:0"><div class="flex items-baseline gap-2"><span class="text-foreground text-[13px] leading-tight font-medium">A model on its own</span><span class="text-muted-foreground/60 truncate text-[11px] leading-tight">answers</span></div><p class="text-foreground/80 text-[13.5px] leading-[1.65] text-pretty">Add exponential backoff, cap it at five attempts, and skip the retry entirely for 4xx responses — those will never succeed. Worth logging the attempt count too.</p><p class="text-muted-foreground/70 mt-auto text-[12.5px] italic">…and then you go and do it.</p></div><div class="border-border bg-background/40 flex min-w-0 flex-col gap-3 border-l px-7 py-7" style="opacity:0"><div class="flex items-baseline gap-2"><span class="text-foreground text-[13px] leading-tight font-medium">With the harness</span><span class="text-muted-foreground/60 truncate text-[11px] leading-tight"><span class="inline-flex items-center gap-1.5 align-middle"><svg width="24" height="30" viewBox="0 0 240 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-3"><g clip-path="url(#clip0_1401_86274)"><mask id="mask0_1401_86274" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="240" height="300"><path d="M240 0H0V300H240V0Z" fill="white"></path></mask><g mask="url(#mask0_1401_86274)"><path d="M180 240H60V120H180V240Z" fill="#CFCECD"></path><path d="M180 60H60V240H180V60ZM240 300H0V0H240V300Z" fill="#211E1E"></path></g></g><defs><clipPath id="clip0_1401_86274"><rect width="240" height="300" fill="white"></rect></clipPath></defs></svg>powered by OpenCode</span></span></div><ul class="flex flex-col gap-2.5"><li class="flex items-center gap-2.5"><span class="relative flex size-4 shrink-0 items-center justify-center"><span class="border-muted-foreground/30 absolute size-3.5 rounded-full border transition-opacity duration-200 opacity-0"></span><span class="absolute inset-0 flex items-center justify-center" style="opacity:1;filter:blur(0px);transform:none"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="text-muted-foreground size-3.5"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span></span><span class="min-w-0 flex-1 truncate text-[13px] leading-tight transition-colors duration-300 text-foreground">Read the webhook handler</span><span class="shrink-0 text-[11px] leading-tight transition-opacity duration-300 text-muted-foreground/60 opacity-100">webhook-retry.ts</span></li><li class="flex items-center gap-2.5"><span class="relative flex size-4 shrink-0 items-center justify-center"><span class="border-muted-foreground/30 absolute size-3.5 rounded-full border transition-opacity duration-200 opacity-0"></span><span class="absolute inset-0 flex items-center justify-center" style="opacity:1;filter:blur(0px);transform:none"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="text-muted-foreground size-3.5"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span></span><span class="min-w-0 flex-1 truncate text-[13px] leading-tight transition-colors duration-300 text-foreground">Patched the retry to back off</span><span class="shrink-0 text-[11px] leading-tight transition-opacity duration-300 text-muted-foreground/60 opacity-100">+18 −6</span></li><li class="flex items-center gap-2.5"><span class="relative flex size-4 shrink-0 items-center justify-center"><span class="border-muted-foreground/30 absolute size-3.5 rounded-full border transition-opacity duration-200 opacity-0"></span><span class="absolute inset-0 flex items-center justify-center" style="opacity:1;filter:blur(0px);transform:none"><svg xmlns="http://www.