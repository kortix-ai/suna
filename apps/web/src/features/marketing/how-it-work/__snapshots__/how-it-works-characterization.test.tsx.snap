al-gradient(circle_at_center,color-mix(in_oklab,var(--foreground)_28%,transparent),transparent_64%)] [@media(prefers-reduced-transparency:reduce)]:hidden"></span><span class="relative z-1 grid size-full place-items-center"><span class="grid aspect-square size-[54%] place-items-center drop-shadow-[0_1.8cqw_2.8cqw_rgb(0_0_0/0.22)] *:size-full *:max-h-full *:max-w-full *:object-contain [&amp;&gt;img]:size-full! [&amp;&gt;svg]:size-full!"><svg width="30" height="25" viewBox="0 0 30 25" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" style="width:24px;height:24px"><path d="M25.56 24.916H29.83C29.83 19.63 26.94 15 22.62 12.46C26.94 9.91 29.83 5.29 29.83 0H25.56C25.56 5 21.89 9.19 17.07 10.17V0H12.8V10.17C7.95 9.2 4.3 5.02 4.3 0H0.04C0.04 5.29 2.93 9.91 7.25 12.46C2.93 15 0.04 19.63 0.04 24.916H4.3C4.3 19.9 7.95 15.71 12.8 14.75V24.92H17.07V14.75C21.91 15.71 25.56 19.9 25.56 24.916Z" fill="currentColor"></path></svg></span></span><span aria-hidden="true" class="pointer-events-none absolute inset-0 z-2 bg-[linear-gradient(128deg,color-mix(in_oklab,var(--background)_48%,transparent)_0%,color-mix(in_oklab,var(--background)_18%,transparent)_36%,transparent_42%)] dark:bg-[linear-gradient(128deg,color-mix(in_oklab,var(--foreground)_48%,transparent)_0%,color-mix(in_oklab,var(--foreground)_18%,transparent)_36%,transparent_42%)] [@media(prefers-reduced-transparency:reduce)]:opacity-35"></span><span aria-hidden="true" class="pointer-events-none absolute top-[-22%] right-[-30%] z-2 h-[88%] w-[92%] rounded-full bg-[radial-gradient(circle_at_38%_28%,color-mix(in_oklab,var(--background)_70%,transparent)_0%,transparent_56%)] opacity-55 mix-blend-soft-light blur-[5cqw] motion-reduce:mix-blend-normal dark:bg-[radial-gradient(circle_at_38%_28%,color-mix(in_oklab,var(--foreground)_70%,transparent)_0%,transparent_56%)] [@media(prefers-reduced-transparency:reduce)]:hidden"></span><span aria-hidden="true" class="pointer-events-none absolute inset-0 z-3 rounded-[22.37%] [corner-shape:squircle] shadow-[inset_0_1px_0_rgb(255_255_255/0.58),inset_0_-1px_0_rgb(0_0_0/0.24),inset_0_0_0_1px_rgb(255_255_255/0.28),inset_0_7cqw_10cqw_rgb(0_0_0/0.14)]"></span></div></div></div></div></div></div></article><article data-stack-layer="models" class="border-border bg-popover flex flex-col overflow-hidden rounded-xl border"><div class="flex w-full items-center gap-3 px-4 py-2 sm:px-6"><span class="text-muted-foreground/60 font-mono text-[11px] tracking-widest tabular-nums">03</span><h3 class="text-foreground truncate text-[15px] font-medium tracking-tight sm:text-base">Run any model. Keep your keys.</h3></div><div class="border-border bg-muted/40 dark:bg-muted/15 border-t p-2 flex flex-col gap-3"><div class="flex min-w-0 flex-col gap-2.5 px-2 pt-2"><p class="text-muted-foreground text-[13px] leading-relaxed">Kortix is model-agnostic. Pick the model per agent, per session or per message, and switch the day a better one lands.</p><ul class="text-muted-foreground space-y-1.5 text-[12.5px] leading-relaxed"><li class="flex gap-2"><div class="relative flex shrink-0 items-center justify-center mt-0 size-4"><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-10" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:0.8s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-20 rotate-90" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:0.88s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-30 rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:0.9600000000000001s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-40 -rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.04s"></div></div><span>Bring your own API key from any major provider, or use ours</span></li><li class="flex gap-2"><div class="relative flex shrink-0 items-center justify-center mt-0 size-4"><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-10" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:0.8s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-20 rotate-90" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:0.88s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-30 rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:0.9600000000000001s"></div><div class="absolute h-3.5 w-px shrink-0 rounded-full animate-kortix-bullet-flow bg-[length:100%_300%] z-40 -rotate-45" style="background-image:linear-gradient(to bottom, var(--kortix-red), var(--kortix-green), var(--kortix-blue), var(--kortix-yellow), var(--kortix-purple), var(--kortix-red));animation-delay:1.04s"></div></div><span>Or sign in with the ChatGPT subscription you already pay for</span></li><li class="flex gap-2"><d