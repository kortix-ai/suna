exports[`shipped marketing route composition enterprise renders its topic tabs section unchanged 1`] = `"<section id="how-it-works" class="scroll-mt-16 py-14 lg:py-20"><div class="kx-rail-fade relative border-y px-4 lg:px-17"><div class="grid grid-cols-1 lg:grid-cols-2"><div class="px-4 py-12 lg:px-11 lg:py-16 lg:pr-12"><h2 class="text-foreground text-xl font-medium tracking-tight text-balance md:text-2xl lg:text-3xl">How it works.<span class="text-muted-foreground block">From the first team to the whole company.</span></h2><div role="tablist" aria-label="How Kortix works for a company" aria-orientation="vertical" class="mt-10 flex flex-col gap-6"><button type="button" role="tab" id="topic-tab-rollout" aria-controls="topic-panel" aria-selected="true" tabindex="0" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Roll out team by team</h3><p class="text-muted-foreground mt-1 text-sm text-balance">Start with one team. Add the next.</p></button><button type="button" role="tab" id="topic-tab-infra" aria-controls="topic-panel" aria-selected="false" tabindex="-1" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Your infrastructure</h3><p class="text-muted-foreground mt-1 text-sm text-balance">Kortix Cloud, your VPC or on-prem.</p></button><button type="button" role="tab" id="topic-tab-models" aria-controls="topic-panel" aria-selected="false" tabindex="-1" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Models and spend control</h3><p class="text-muted-foreground mt-1 text-sm text-balance">Any model, with limits you set.</p></button><button type="button" role="tab" id="topic-tab-governance" aria-controls="topic-panel" aria-selected="false" tabindex="-1" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Governance in one place</h3><p class="text-muted-foreground mt-1 text-sm text-balance">Sign-in, roles, approvals and audit.</p></button><button type="button" role="tab" id="topic-tab-build" aria-controls="topic-panel" aria-selected="false" tabindex="-1" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Build on it</h3><p class="text-muted-foreground mt-1 text-sm text-balance">API, CLI, SDK and UI kit.</p></button><button type="button" role="tab" id="topic-tab-work" aria-controls="topic-panel" aria-selected="false" tabindex="-1" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Working with us</h3><p class="text-muted-foreground mt-1 text-sm text-balance">A demo, a contract, a team behind it.</p></button></div></div><div role="tabpanel" id="topic-panel" aria-labelledby="topic-tab-rollout" class="bg-card flex items-center justify-center border-t p-6 sm:p-8 lg:border-t-0 lg:border-l lg:p-12"><div class="animate-in fade-in duration-slower flex w-full max-w-xl min-w-0 flex-col gap-8 ease-out"><div class="flex flex-col gap-3"><h3 class="text-foreground text-xl font-medium tracking-tight">Roll out team by team</h3><p class="text-muted-foreground text-base text-pretty">Each agent has a job, its skills and the connectors it may use. Grant each team its project and the agents it may run.</p><p class="text-muted-foreground text-base text-pretty">Drive gives people and agents shared folders. The company’s memory lives there as Markdown files every project member can read.</p></div><div class="bg-background flex min-w-0 flex-1 flex-col overflow-hidden rounded-lg border"><div class="flex items-center gap-3 border-b px-4 py-3"><span aria-hidden="true" class="flex items-center gap-1.5"><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span></span><span class="text-muted-foreground min-w-0 truncate font-mono text-xs">Arcadia · Drive</span></div><ul class="flex flex-col divide-y"><li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 py-3"><code class="text-foreground font-mono text-sm">Company/Memory/</code><span class="text-muted-foreground text-sm">every project member</span></li><li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 py-3"><code class="text-foreground font-mono text-sm">Company/Memory/customers.md</code></li><li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 py-3"><code class="text-foreground font-mono text-sm">Company/Memory/conventions.md</code></li><li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 py-3"><code class="text-foreground font-mono text-sm">Support/</code><span class="text-muted-foreground text-sm">shared with the Support group</span></li><li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 py-3"><code class="text-foreground font-mono text-sm">My files/</code><span class="text-muted-foreground text-sm">only you</span></li></ul></div></div></div></div></div></section>"`;

exports[`shipped marketing route composition compliance renders its topic tabs section unchanged 1`] = `"<section id="how-it-works" class="scroll-mt-16 py-14 lg:py-20"><div class="kx-rail-fade relative border-y px-4 lg:px-17"><div class="grid grid-cols-1 lg:grid-cols-2"><div class="px-4 py-12 lg:px-11 lg:py-16 lg:pr-12"><h2 class="text-foreground text-xl font-medium tracking-tight text-balance md:text-2xl lg:text-3xl">How it works.<span class="text-muted-foreground block">One topic at a time.</span></h2><div role="tablist" aria-label="How the controls work" aria-orientation="vertical" class="mt-10 flex flex-col gap-6"><button type="button" role="tab" id="topic-tab-identity" aria-controls="topic-panel" aria-selected="true" tabindex="0" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Single sign-on and directory sync</h3><p class="text-muted-foreground mt-1 text-sm text-balance">Your identity provider decides who gets in.</p></button><button type="button" role="tab" id="topic-tab-access" aria-controls="topic-panel" aria-selected="false" tabindex="-1" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Roles, groups and agents</h3><p class="text-muted-foreground mt-1 text-sm text-balance">Who opens which workspace, and runs which agent.</p></button><button type="button" role="tab" id="topic-tab-governance" aria-controls="topic-panel" aria-selected="false" tabindex="-1" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Approvals and policy</h3><p class="text-muted-foreground mt-1 text-sm text-balance">Rules in kortix.yaml, reviewed like code.</p></button><button type="button" role="tab" id="topic-tab-audit" aria-controls="topic-panel" aria-selected="false" tabindex="-1" class="outline-ring duration-moderate w-full rounded-sm text-left opacity-50 transition-opacity ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 aria-selected:opacity-100"><h3 class="text-foreground text-base font-medium text-pretty">Audit log</h3><p class="text-muted-foreground mt-1 text-sm text-balance">Read it, export it, stream it.</p></button></div></div><div role="tabpanel" id="topic-panel" aria-labelledby="topic-tab-identity" class="bg-card flex items-center justify-center border-t p-6 sm:p-8 lg:border-t-0 lg:border-l lg:p-12"><div class="animate-in fade-in duration-slower flex w-full max-w-xl min-w-0 flex-col gap-8 ease-out"><div class="flex flex-col gap-3"><h3 class="text-foreground text-xl font-medium tracking-tight">Single sign-on and directory sync</h3><p class="text-muted-foreground text-base text-pretty">People sign in with SAML 2.0 single sign-on. Enforce it, and other ways to sign in for your domain stop working.</p><p class="text-muted-foreground text-base text-pretty">SCIM 2.0 keeps members and groups in sync. Map an identity provider group to a Kortix group once.</p></div><div class="bg-background flex min-w-0 flex-1 flex-col overflow-hidden rounded-lg border"><div class="flex items-center gap-3 border-b px-4 py-3"><span aria-hidden="true" class="flex items-center gap-1.5"><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span></span><span class="text-muted-foreground min-w-0 truncate font-mono text-xs">Identity → Group mappings</span></div><ul class="flex flex-col divide-y"><li class="flex items-center gap-3 px-4 py-2.5"><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase flex-1">Directory group</span><span aria-hidden="true" class="w-4"></span><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase flex-1">Kortix group</span></li><li class="flex items-center gap-3 px-4 py-3"><code class="text-muted-foreground min-w-0 flex-1 font-mono text-xs break-all sm:text-sm">arcadia-eng</code><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="text-muted-foreground size-4 shrink-0" aria-hidden="true"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg><span class="text-foreground min-w-0 flex-1 text-sm font-medium">Engineering</span></li><li class="flex items-center gap-3 px-4 py-3"><code class="text-muted-foreground min-w-0 flex-1 font-mono text-xs break-all sm:text-sm">arcadia-support</code><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="text-muted-foreground size-4 shrink-0" aria-hidden="true"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg><span class="text-foreground min-w-0 flex-1 text-sm font-medium">Support</span></li><li class="flex items-center gap-3 px-4 py-3"><code class="text-muted-foreground min-w-0 flex-1 font-mono text-xs break-all sm:text-sm">arcadia-fin</code><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="text-muted-foreground size-4 shrink-0" aria-hidden="true"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg><span class="text-foreground min-w-0 flex-1 text-sm font-medium">Finance</span></li></ul></div></div></div></div></div></section>"`;

