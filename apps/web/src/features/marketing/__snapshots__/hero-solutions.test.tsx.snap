exports[`solution page hero characterization multiplayer hero renders its shipped fold and first walkthrough step 1`] = `"<section id="hero" class="relative"><div class="relative flex flex-col gap-7.5 px-8 pt-32 pb-18 lg:px-28 lg:pt-40"><div class="flex flex-col gap-4 lg:gap-5"><h1 class="max-w-261 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-[44px] lg:leading-13"><span class="text-foreground block">Multiplayer AI.</span><span class="text-muted-foreground block">One AI for the whole team.</span></h1><p class="text-muted-foreground max-w-2xl text-base text-pretty sm:text-lg md:text-xl">Everyone works with the same agents, skills, memory and connectors. Share a session, write in it together, and approve what the agent does.</p></div><div class="flex flex-wrap gap-2.5 pt-2"><a href="/docs/guide#teams" data-variant="secondary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1">Read the Teams guide</a><a data-variant="primary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1" href="/auth">Start for free</a></div></div><div class="kx-rail-fade relative border-y px-4 lg:px-17"><div class="bg-card flex flex-col items-center gap-7 px-3 py-8 lg:gap-10 lg:px-11 lg:pt-17 lg:pb-10"><div class="flex w-full flex-col items-center gap-8"><div role="tabpanel" id="multiplayer-walk-panel" aria-labelledby="multiplayer-walk-start" class="w-full max-w-304"><div aria-hidden="true" class="bg-background flex h-132 w-full overflow-hidden rounded-xl border text-left lg:h-140"><aside aria-hidden="true" class="bg-sidebar hidden w-56 shrink-0 flex-col gap-1 border-r p-3 lg:flex"><span class="text-foreground px-2 py-1.5 text-sm font-medium">Arcadia</span><span class="text-foreground flex items-center gap-2 rounded-md px-2 py-1.5 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-4"><path d="M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z"></path></svg>New session</span><span class="text-muted-foreground mt-4 px-2 text-xs">Sessions</span><span class="truncate rounded-md px-2 py-1.5 text-sm bg-sidebar-accent text-foreground">Q3 board pack</span><span class="truncate rounded-md px-2 py-1.5 text-sm text-muted-foreground">Weekly pipeline review</span><span class="truncate rounded-md px-2 py-1.5 text-sm text-muted-foreground">Vendor contract renewals</span></aside><section class="relative flex min-w-0 flex-1 flex-col"><header class="flex h-12 shrink-0 items-center justify-between gap-2 border-b px-4"><span class="text-foreground truncate text-sm">Q3 board pack</span><div class="flex shrink-0 items-center gap-2"><span class="text-foreground flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-3.5"><path d="M176,160a39.89,39.89,0,0,0-28.62,12.09l-46.1-29.63a39.8,39.8,0,0,0,0-28.92l46.1-29.63a40,40,0,1,0-8.66-13.45l-46.1,29.63a40,40,0,1,0,0,55.82l46.1,29.63A40,40,0,1,0,176,160Zm0-128a24,24,0,1,1-24,24A24,24,0,0,1,176,32ZM64,152a24,24,0,1,1,24-24A24,24,0,0,1,64,152Zm112,72a24,24,0,1,1,24-24A24,24,0,0,1,176,224Z"></path></svg>Share</span></div></header><div class="flex min-h-0 flex-1 flex-col justify-end overflow-hidden [mask-image:linear-gradient(to_bottom,transparent,black_3rem)] px-4 pt-4 lg:px-8"><div class="mx-auto w-full max-w-xl pb-4"><div class="flex flex-col gap-4"><div class="flex flex-col items-end gap-1.5"><p class="bg-secondary text-foreground max-w-[85%] rounded-lg px-3.5 py-2.5 text-sm text-pretty">Draft the Q3 board pack from the Finance folder and email it to the board.</p></div><p class="text-foreground text-sm text-pretty">I will build the pack from the Q3 numbers, in the board template.</p><ol class="relative flex flex-col gap-2"><span aria-hidden="true" class="bg-border absolute top-2 bottom-2 left-2 w-px"></span><li class="relative flex min-w-0 items-center gap-2.5 text-sm"><span class="bg-background text-muted-foreground flex size-4 flex-none items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-4" aria-hidden="true"><path d="M232,48H160a40,40,0,0,0-32,16A40,40,0,0,0,96,48H24a8,8,0,0,0-8,8V200a8,8,0,0,0,8,8H96a24,24,0,0,1,24,24,8,8,0,0,0,16,0,24,24,0,0,1,24-24h72a8,8,0,0,0,8-8V56A8,8,0,0,0,232,48ZM96,192H32V64H96a24,24,0,0,1,24,24V200A39.81,39.81,0,0,0,96,192Zm128,0H160a39.81,39.81,0,0,0-24,8V88a24,24,0,0,1,24-24h64ZM160,88h40a8,8,0,0,1,0,16H160a8,8,0,0,1,0-16Zm48,40a8,8,0,0,1-8,8H160a8,8,0,0,1,0-16h40A8,8,0,0,1,208,128Zm0,32a8,8,0,0,1-8,8H160a8,8,0,0,1,0-16h40A8,8,0,0,1,208,160Z"></path></svg></span><span class="text-foreground flex-none">Loaded skill</span><span class="text-muted-foreground min-w-0 truncate font-mono text-xs">board-pack</span></li><li class="relative flex min-w-0 items-center gap-2.5 text-sm"><span class="bg-background text-muted-foreground flex size-4 flex-none items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-4" aria-hidden="true"><path d="M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,136Zm0,32a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,168Z"></path></svg></span><span class="text-foreground flex-none">Read</span><span class="text-muted-foreground min-w-0 truncate font-mono text-xs">Company/Memory/finance.md</span></li><li class="relative flex min-w-0 items-center gap-2.5 text-sm"><span class="bg-background text-muted-foreground flex size-4 flex-none items-center justify-center"><svg class="text-foreground in-[button]:text-background in-data-[slot=button]:text-background in-[button.bg-transparent]:text-foreground in-[[data-slot=button].bg-transparent]:text-foreground in-[button.bg-secondary]:text-foreground! in-[[data-slot=button].bg-secondary]:text-foreground! animate-spinner-orbit size-3.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><circle class="animate-spinner-dash" cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"></circle></svg></span><span class="text-foreground flex-none">Building</span><span class="text-muted-foreground min-w-0 truncate font-mono text-xs">q3-board-pack.pptx</span></li></ol></div></div></div><div class="mx-auto w-full max-w-xl px-4 pb-4 lg:px-0"><div class="flex items-center gap-2 rounded-xl border px-3 py-2.5"><span class="text-muted-foreground min-w-0 flex-1 truncate text-sm">Type / for skills, commands, and files</span><span class="text-muted-foreground font-mono text-xs">kortix</span><span class="bg-foreground text-background flex size-7 shrink-0 items-center justify-center rounded-full"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-3.5"><path d="M205.66,117.66a8,8,0,0,1-11.32,0L136,59.31V216a8,8,0,0,1-16,0V59.31L61.66,117.66a8,8,0,0,1-11.32-11.32l72-72a8,8,0,0,1,11.32,0l72,72A8,8,0,0,1,205.66,117.66Z"></path></svg></span></div></div></section></div></div><div class="flex flex-col items-center gap-5"><div role="tablist" aria-label="One shared session, step by step" class="flex flex-wrap justify-center gap-2"><button type="button" role="tab" id="multiplayer-walk-start" aria-controls="multiplayer-walk-panel" aria-selected="true" tabindex="0" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">1</span>Start</button><button type="button" role="tab" id="multiplayer-walk-share" aria-controls="multiplayer-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">2</span>Share</button><button type="button" role="tab" id="multiplayer-walk-together" aria-controls="multiplayer-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">3</span>Write together</button><button type="button" role="tab" id="multiplayer-walk-approve" aria-controls="multiplayer-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">4</span>Approve</button></div><p class="text-foreground max-w-2xl px-4 text-center text-base text-balance animate-in fade-in duration-slower ease-out">Member 1 starts a session. The agent loads the team’s skill and reads the company’s memory.</p></div></div><p class="text-foreground px-4 text-center text-base font-medium text-balance">One session, many people. <span class="text-muted-foreground">Everyone with access reads it and continues it.</span></p></div></div></section>"`;

exports[`solution page hero characterization security hero renders its shipped fold and first walkthrough step 1`] = `"<section id="hero" class="relative"><div class="relative flex flex-col gap-7.5 px-8 pt-32 pb-18 lg:px-28 lg:pt-40"><div class="flex flex-col gap-4 lg:gap-5"><h1 class="max-w-261 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-[44px] lg:leading-13"><span class="text-foreground block">Secure by construction.</span><span class="text-muted-foreground block">Agents reach your tools only through gates you control.</span></h1><p class="text-muted-foreground max-w-2xl text-base text-pretty sm:text-lg md:text-xl">A person grants an agent access. The agent runs as itself on its own isolated computer. Kortix decides which keys reach that computer, and checks every app call, model call and change it makes.</p></div><div class="flex flex-wrap gap-2.5 pt-2"><a data-variant="secondary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1" href="/contact">Talk to us</a><a href="/docs/guide#security" data-variant="primary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1">Read the security docs</a></div></div><div class="kx-rail-fade relative border-y px-4 lg:px-17"><div class="bg-card flex flex-col items-center gap-7 px-4 py-8 lg:gap-10 lg:px-11 lg:pt-17 lg:pb-10"><div class="flex w-full flex-col gap-8 lg:gap-10"><div role="tabpanel" id="security-walk-panel" aria-labelledby="security-walk-tool" class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1.3fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)] lg:items-stretch"><div class="bg-background flex min-w-0 flex-col gap-3 rounded-lg border p-5 lg:p-6"><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase">A person</span><div class="text-foreground flex items-center gap-2.5 text-lg font-medium lg:text-xl"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-5 shrink-0" aria-hidden="true"><path d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z"></path></svg>You</div><p class="text-muted-foreground text-sm text-pretty">Choose which agent may run, and grant it access.</p></div><div aria-hidden="true" class="text-muted-foreground flex justify-center py-2 lg:px-3 lg:py-0"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-5 lg:hidden"><path d="M205.66,149.66l-72,72a8,8,0,0,1-11.32,0l-72-72a8,8,0,0,1,11.32-11.32L120,196.69V40a8,8,0,0,1,16,0V196.69l58.34-58.35a8,8,0,0,1,11.32,11.32Z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="hidden size-5 lg:block"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg></div><div class="bg-background flex min-w-0 flex-col gap-3 rounded-lg border border-dashed p-5 lg:p-6"><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase">Its own computer</span><div class="text-foreground text-lg font-medium lg:text-xl">The agent</div><p class="text-muted-foreground text-sm text-pretty">Acts as itself, never with your role.</p><span class="bg-muted text-foreground mt-auto self-start rounded-md px-2.5 py-1 text-sm font-medium animate-in fade-in duration-slower ease-out">Run a command</span></div><div aria-hidden="true" class="text-muted-foreground flex justify-center py-2 lg:px-3 lg:py-0"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-5 lg:hidden"><path d="M205.66,149.66l-72,72a8,8,0,0,1-11.32,0l-72-72a8,8,0,0,1,11.32-11.32L120,196.69V40a8,8,0,0,1,16,0V196.69l58.34-58.35a8,8,0,0,1,11.32,11.32Z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="hidden size-5 lg:block"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg></div><div class="bg-background flex min-w-0 flex-col gap-3 rounded-lg border p-5 lg:p-6 border-foreground"><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase">Kortix gate</span><div class="text-foreground flex items-center gap-2.5 text-lg font-medium lg:text-xl"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-5 shrink-0" aria-hidden="true"><path d="M208,40H48A16,16,0,0,0,32,56v56c0,52.72,25.52,84.67,46.93,102.19,23.06,18.86,46,25.26,47,25.53a8,8,0,0,0,4.2,0c1-.27,23.91-6.67,47-25.53C198.48,196.67,224,164.72,224,112V56A16,16,0,0,0,208,40Zm0,72c0,37.07-13.66,67.16-40.6,89.42A129.3,129.3,0,0,1,128,223.62a128.25,128.25,0,0,1-38.92-21.81C61.82,179.51,48,149.3,48,112l0-56,160,0ZM82.34,141.66a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32l-56,56a8,8,0,0,1-11.32,0Z"></path></svg><span class="animate-in fade-in duration-slower ease-out">Tool rules</span></div><p class="text-muted-foreground text-sm text-pretty">Checked by the runtime, before the tool runs.</p></div><div aria-hidden="true" class="text-muted-foreground flex justify-center py-2 lg:px-3 lg:py-0"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-5 lg:hidden"><path d="M205.66,149.66l-72,72a8,8,0,0,1-11.32,0l-72-72a8,8,0,0,1,11.32-11.32L120,196.69V40a8,8,0,0,1,16,0V196.69l58.34-58.35a8,8,0,0,1,11.32,11.32Z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="hidden size-5 lg:block"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg></div><div class="bg-background flex min-w-0 flex-col gap-3 rounded-lg border p-5 lg:p-6"><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase">Resource</span><div class="text-foreground flex items-center gap-2.5 text-lg font-medium lg:text-xl"><span class="animate-in fade-in duration-slower ease-out">Files and commands</span></div><p class="text-muted-foreground text-sm text-pretty">Reached only after the check.</p></div></div><div class="flex flex-col items-center gap-5"><div role="tablist" aria-label="The five gates" class="flex flex-wrap justify-center gap-2"><button type="button" role="tab" id="security-walk-tool" aria-controls="security-walk-panel" aria-selected="true" tabindex="0" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">1</span>Tool rules</button><button type="button" role="tab" id="security-walk-connector" aria-controls="security-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">2</span>Connector broker</button><button type="button" role="tab" id="security-walk-secret" aria-controls="security-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">3</span>Secret broker</button><button type="button" role="tab" id="security-walk-model" aria-controls="security-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">4</span>LLM gateway</button><button type="button" role="tab" id="security-walk-change" aria-controls="security-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">5</span>Review</button></div><p class="text-foreground max-w-2xl px-4 text-center text-base text-balance animate-in fade-in duration-slower ease-out">The runtime checks allow, ask or deny before every tool runs.</p></div></div><p class="text-foreground px-4 text-center text-base font-medium text-balance">One computer per session. <span class="text-muted-foreground">Connector logins and Kortix’s model keys never enter it.</span></p></div></div></section>"`;

exports[`solution page hero characterization self-hosted hero renders its shipped fold and first walkthrough step 1`] = `"<section id="hero" class="relative"><div class="relative flex flex-col gap-7.5 px-8 pt-32 pb-18 lg:px-28 lg:pt-40"><div class="flex flex-col gap-4 lg:gap-5"><h1 class="max-w-261 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-[44px] lg:leading-13"><span class="text-foreground block">Self-host Kortix.</span><span class="text-muted-foreground block">One CLI, one server, the whole platform.</span></h1><p class="text-muted-foreground max-w-2xl text-base text-pretty sm:text-lg md:text-xl">The kortix CLI installs the web app, the API, the LLM gateway and the database on your server as one Docker Compose stack. Then it keeps the stack up to date.</p></div><div class="flex flex-wrap gap-2.5 pt-2"><a data-variant="secondary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1" href="/sovereign">Why self-host</a><a href="/docs/developers#self-hosting" data-variant="primary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1">Read the self-hosting guide</a></div></div><div class="kx-rail-fade relative border-y px-4 lg:px-17"><div class="bg-card flex flex-col items-center gap-7 px-4 py-8 lg:gap-10 lg:px-11 lg:pt-17 lg:pb-10"><div class="flex w-full flex-col items-center gap-8 lg:gap-10"><div role="tablist" aria-label="Install steps" class="flex flex-wrap justify-center gap-2"><button type="button" role="tab" id="selfhost-walk-install" aria-controls="selfhost-walk-panel" aria-selected="true" tabindex="0" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">1</span>Install the CLI</button><button type="button" role="tab" id="selfhost-walk-init" aria-controls="selfhost-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">2</span>Configure</button><button type="button" role="tab" id="selfhost-walk-start" aria-controls="selfhost-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">3</span>Start</button><button type="button" role="tab" id="selfhost-walk-doctor" aria-controls="selfhost-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">4</span>Check</button></div><div role="tabpanel" id="selfhost-walk-panel" aria-labelledby="selfhost-walk-install" class="flex w-full max-w-3xl flex-col gap-6"><div class="flex min-h-80 flex-col animate-in fade-in duration-slower ease-out"><div class="bg-background flex min-w-0 flex-1 flex-col overflow-hidden rounded-lg border"><div class="flex items-center gap-3 border-b px-4 py-3"><span aria-hidden="true" class="flex items-center gap-1.5"><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span></span><span class="text-muted-foreground min-w-0 truncate font-mono text-xs">Terminal: your server</span></div><pre class="font-mono text-xs leading-6 whitespace-pre-wrap sm:text-sm sm:leading-7 px-4 py-4 sm:px-6"><code class="flex flex-col"><span class="text-foreground pl-4 -indent-4 wrap-break-word"><span class="text-muted-foreground select-none">$ </span>curl -fsSL https://kortix.com/install | bash</span><span class="text-muted-foreground pl-4 -indent-4 wrap-break-word">▸  Resolving latest release from GitHub…</span><span class="text-foreground pl-4 -indent-4 wrap-break-word"><span class="text-kortix-green">✓</span>  Latest release: &lt;version&gt;</span><span class="text-foreground pl-4 -indent-4 wrap-break-word"><span class="text-kortix-green">✓</span>  Checksum verified (&lt;sha256&gt;)</span><span class="text-foreground pl-4 -indent-4 wrap-break-word"><span class="text-kortix-green">✓</span>  Installed binary at /home/ops/.kortix/kortix</span></code></pre></div></div><p class="text-foreground px-4 text-center text-base text-balance animate-in fade-in duration-slower ease-out">One line installs the kortix CLI. It runs on Linux and macOS, on x86_64 and arm64.</p></div></div><p class="text-foreground px-4 text-center text-base font-medium text-balance">Four commands on a Linux server with Docker. <span class="text-muted-foreground">Then sign in at your own domain.</span></p></div></div></section>"`;

exports[`solution page hero characterization sovereign hero renders its shipped fold and first walkthrough step 1`] = `"<section id="hero" class="relative"><div class="relative flex flex-col gap-7.5 px-8 pt-32 pb-18 lg:px-28 lg:pt-40"><div class="flex flex-col gap-4 lg:gap-5"><h1 class="max-w-261 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-[44px] lg:leading-13"><span class="text-foreground block">Sovereign and open.</span><span class="text-muted-foreground block">Open source, on your infrastructure, with any model.</span></h1><p class="text-muted-foreground max-w-2xl text-base text-pretty sm:text-lg md:text-xl">Read every line of Kortix. Run it on Kortix Cloud, in your VPC or on your own on-prem network. Bring any model with your own keys, and keep your company in a git repository you own.</p></div><div class="flex flex-wrap gap-2.5 pt-2"><a href="https://github.com/kortix-ai/CompanyOS" target="_blank" rel="noreferrer" data-variant="secondary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1">View on GitHub</a><a data-variant="primary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1" href="/self-hosted">Self-host Kortix</a></div></div><div class="kx-rail-fade relative border-y px-4 lg:px-17"><div class="bg-card flex flex-col items-center gap-7 px-4 py-8 lg:gap-10 lg:px-11 lg:pt-17 lg:pb-10"><div class="flex w-full flex-col items-center gap-8 lg:gap-10"><div role="tablist" aria-label="What stays yours" class="flex flex-wrap