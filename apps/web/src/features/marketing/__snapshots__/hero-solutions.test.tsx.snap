exports[`solution page hero characterization compliance hero renders its shipped fold and first walkthrough step 1`] = `"<section id="hero" class="relative"><div class="relative flex flex-col gap-7.5 px-8 pt-32 pb-18 lg:px-28 lg:pt-40"><div class="flex flex-col gap-4 lg:gap-5"><h1 class="max-w-261 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-[44px] lg:leading-13"><span class="text-foreground block">Compliance and control.</span><span class="text-muted-foreground block">Your sign-in, your roles, your audit trail.</span></h1><p class="text-muted-foreground max-w-2xl text-base text-pretty sm:text-lg md:text-xl">What IT and compliance reviewers ask about: how people sign in, who may run which agent, which actions wait for a person, and what gets recorded.</p></div><div class="flex flex-wrap gap-2.5 pt-2"><a data-variant="secondary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1" href="/pricing">Compare plans</a><button data-variant="primary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1">Talk to sales</button></div></div><div class="kx-rail-fade relative border-y px-4 lg:px-17"><div class="bg-card flex flex-col items-center gap-7 px-4 py-8 lg:gap-10 lg:px-11 lg:pt-17 lg:pb-10"><div class="flex w-full flex-col items-center gap-8 lg:gap-10"><div role="tablist" aria-label="How an admin sets up the controls" class="flex flex-wrap justify-center gap-2"><button type="button" role="tab" id="compliance-walk-sso" aria-controls="compliance-walk-panel" aria-selected="true" tabindex="0" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">1</span>Sign-in</button><button type="button" role="tab" id="compliance-walk-directory" aria-controls="compliance-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">2</span>Directory</button><button type="button" role="tab" id="compliance-walk-access" aria-controls="compliance-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">3</span>Access</button><button type="button" role="tab" id="compliance-walk-approvals" aria-controls="compliance-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">4</span>Approvals</button><button type="button" role="tab" id="compliance-walk-audit" aria-controls="compliance-walk-panel" aria-selected="false" tabindex="-1" class="text-muted-foreground hover:text-foreground aria-selected:bg-background aria-selected:text-foreground outline-ring duration-normal aria-selected:border-border flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors ease-out focus-visible:outline-2 focus-visible:outline-offset-2"><span class="font-mono text-xs tabular-nums">5</span>Audit</button></div><div role="tabpanel" id="compliance-walk-panel" aria-labelledby="compliance-walk-sso" class="flex w-full max-w-3xl flex-col gap-6"><div class="flex min-h-90 flex-col justify-center animate-in fade-in duration-slower ease-out"><div class="bg-background flex min-w-0 flex-col overflow-hidden rounded-lg border flex-none"><div class="flex items-center gap-3 border-b px-4 py-3"><span aria-hidden="true" class="flex items-center gap-1.5"><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span></span><span class="text-muted-foreground min-w-0 truncate font-mono text-xs">Arcadia · Identity</span></div><ul class="flex flex-col divide-y"><li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6"><div class="flex min-w-0 flex-col"><span class="text-foreground text-sm font-medium">SAML 2.0 single sign-on</span><span class="text-muted-foreground text-sm">Your identity provider</span></div><span class="text-foreground inline-flex shrink-0 items-center gap-1.5 rounded-sm px-2 py-0.5 text-sm font-medium bg-kortix-green/15"><span aria-hidden="true" class="size-1.5 rounded-full bg-kortix-green"></span>Connected</span></li><li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6"><div class="flex min-w-0 flex-col"><span class="text-foreground text-sm font-medium">Domain</span><span class="text-muted-foreground text-sm">arcadia.example</span></div><span class="text-foreground inline-flex shrink-0 items-center gap-1.5 rounded-sm px-2 py-0.5 text-sm font-medium bg-kortix-green/15"><span aria-hidden="true" class="size-1.5 rounded-full bg-kortix-green"></span>Verified</span></li><li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6"><div class="flex min-w-0 flex-col"><span class="text-foreground text-sm font-medium">Enforce SSO for this domain</span><span class="text-muted-foreground text-sm">Other ways to sign in stop working</span></div><span class="text-foreground inline-flex shrink-0 items-center gap-1.5 rounded-sm px-2 py-0.5 text-sm font-medium bg-kortix-green/15"><span aria-hidden="true" class="size-1.5 rounded-full bg-kortix-green"></span>On</span></li><li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6"><div class="flex min-w-0 flex-col"><span class="text-foreground text-sm font-medium">Directory sync (SCIM 2.0)</span><span class="text-muted-foreground text-sm">Members and groups</span></div><span class="text-foreground inline-flex shrink-0 items-center gap-1.5 rounded-sm px-2 py-0.5 text-sm font-medium bg-kortix-green/15"><span aria-hidden="true" class="size-1.5 rounded-full bg-kortix-green"></span>Syncing</span></li></ul></div></div><p class="text-foreground px-4 text-center text-base text-balance animate-in fade-in duration-slower ease-out">People sign in through your identity provider. Enforce it, and no other way in works for your domain.</p></div></div><p class="text-foreground px-4 text-center text-base font-medium text-balance">One account for the whole company. <span class="text-muted-foreground">Owners and admins set it up in Account settings.</span></p></div></div></section>"`;

exports[`solution page hero characterization enterprise hero renders its shipped fold and first walkthrough step 1`] = `"<section id="hero" class="relative"><div class="relative flex flex-col gap-7.5 px-8 pt-32 pb-18 lg:px-28 lg:pt-40"><div class="flex flex-col gap-4 lg:gap-5"><h1 class="max-w-261 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-[44px] lg:leading-13"><span class="text-foreground block">One CompanyOS for every team.</span><span class="text-muted-foreground block">Every team’s agents and memory, in one place you own.</span></h1><p class="text-muted-foreground max-w-2xl text-base text-pretty sm:text-lg md:text-xl">Roll Kortix out team by team. Agents run around the clock on schedules and webhooks, on Kortix Cloud or your own infrastructure, with any model.</p></div><div class="flex flex-wrap gap-2.5 pt-2"><a data-variant="secondary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1" href="/pricing">Compare plans</a><button data-variant="primary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1">Talk to sales</button></div></div><div class="kx-rail-fade relative border-y px-4 lg:px-17"><div class="bg-card flex flex-col items-center gap-7 px-4 py-8 lg:gap-10 lg:px-11 lg:pt-17 lg:pb-10"><div class="flex w-full flex-col items-center gap-8 lg:gap-10"><div role="tablist" aria-label="How Kortix rolls out across a company" class="flex flex-wrap justify-center gap-2"><button type="button" role="tab" id="enterprise-walk-one" 