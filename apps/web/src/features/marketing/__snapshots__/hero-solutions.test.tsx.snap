utline-offset-2"><span class="font-mono text-xs tabular-nums">4</span>Governed</button></div><div role="tabpanel" id="enterprise-walk-panel" aria-labelledby="enterprise-walk-one" class="flex w-full max-w-3xl flex-col gap-6"><div class="bg-background flex min-w-0 flex-1 flex-col overflow-hidden rounded-lg border"><div class="flex items-center gap-3 border-b px-4 py-3"><span aria-hidden="true" class="flex items-center gap-1.5"><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span><span class="bg-muted-foreground/40 size-2.5 rounded-full"></span></span><span class="text-muted-foreground min-w-0 truncate font-mono text-xs">Arcadia · Agents</span></div><ul class="grid grid-cols-1 gap-3 p-3 sm:grid-cols-2 sm:p-4"><li class="flex min-h-28 flex-col gap-2 rounded-md border p-4 bg-background"><div class="flex items-center justify-between gap-3"><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase">Support</span><span class="animate-in fade-in duration-slower ease-out"><span class="text-foreground inline-flex shrink-0 items-center gap-1.5 rounded-sm px-2 py-0.5 text-sm font-medium bg-kortix-green/15"><span aria-hidden="true" class="size-1.5 rounded-full bg-kortix-green"></span>Live</span></span></div><code class="text-foreground font-mono text-sm font-medium">support-triage</code><span class="text-muted-foreground text-sm text-pretty animate-in fade-in duration-slower ease-out">Drafts a reply to each new ticket</span></li><li class="flex min-h-28 flex-col gap-2 rounded-md border p-4 border-dashed"><div class="flex items-center justify-between gap-3"><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase">Sales</span></div><span class="text-muted-foreground text-sm">Next team</span></li><li class="flex min-h-28 flex-col gap-2 rounded-md border p-4 border-dashed"><div class="flex items-center justify-between gap-3"><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase">Finance</span></div><span class="text-muted-foreground text-sm">Next team</span></li><li class="flex min-h-28 flex-col gap-2 rounded-md border p-4 border-dashed"><div class="flex items-center justify-between gap-3"><span class="text-muted-foreground font-mono text-xs tracking-wide uppercase">Engineering</span></div><span class="text-muted-foreground text-sm">Next team</span></li></ul><div class="flex min-h-12 flex-col justify-center border-t px-4 py-3 sm:px-6"><span class="text-muted-foreground text-sm">One project, one agent, one team.</span></div></div><p class="text-foreground px-4 text-center text-base text-balance animate-in fade-in duration-slower ease-out">Start with one team and one agent. It works in the tools that team already uses.</p></div></div><p class="text-foreground px-4 text-center text-base font-medium text-balance">One account for every team. <span class="text-muted-foreground">Members are unlimited.</span></p></div></div></section>"`;

exports[`solution page hero characterization framework hero renders its shipped fold and first walkthrough step 1`] = `"<section id="hero" class="relative"><div class="relative flex flex-col gap-7.5 px-8 pt-32 pb-18 lg:px-28 lg:pt-40"><div class="flex flex-col gap-4 lg:gap-5"><h1 class="max-w-261 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-[44px] lg:leading-13"><span class="text-foreground block">Company as code.</span><span class="text-muted-foreground block">A backend framework and server for agents.</span></h1><p class="text-muted-foreground max-w-2xl text-base text-pretty sm:text-lg md:text-xl">A project is a git repo. Every agent in it is a custom pi agent: a minimal open-source harness you extend with pi extensions. kortix.yaml declares the agents, connectors, triggers and rules. Kortix deploys them to the cloud and runs every session on its own computer. Build your own experience with @kortix/sdk and @kortix/ui.</p></div><div class="flex flex-wrap gap-2.5 pt-2"><a href="https://github.com/kortix-ai/CompanyOS" target="_blank" rel="noreferrer" data-variant="secondary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1">View on GitHub</a><a href="/docs/developers#kortixyaml-reference" data-variant="primary" class="kx-button inline-flex shrink-0 items-center justify-center gap-2 rounded-sm font-medium whitespace-nowrap select-none outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-6 text-sm hit-area-y-1">Read the kortix.yaml reference</a></div></div><div class="kx-rail-fade relative border-y px-4 lg:px-17"><div class="bg-card flex flex-col items-center gap-7 px-4 py-8 l