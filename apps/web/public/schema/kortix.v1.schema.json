{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kortix.com/schema/kortix.v1.schema.json",
  "title": "Kortix manifest (kortix_version 1)",
  "description": "kortix.toml / kortix.yaml, schema version 1 — `[[agents]]` is a per-agent governance OVERLAY (connectors/kortix_permissions/env grants); absence means an unrestricted default agent (adopt-to-govern back-compat). `[[channels]]` is accepted (validated, though dead at runtime).",
  "type": "object",
  "required": [
    "kortix_version"
  ],
  "properties": {
    "kortix_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "env": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      },
      "additionalProperties": true
    },
    "opencode": {
      "type": "object",
      "properties": {
        "config_dir": {
          "type": "string",
          "pattern": "\\S",
          "not": {
            "pattern": "^/|(^|/)\\.\\.($|/)"
          },
          "description": "Directory with the OpenCode-only files (opencode.jsonc, plugins/, tools/). Defaults to harnesses/opencode, then the legacy .kortix/opencode."
        }
      },
      "additionalProperties": true
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "image": false,
        "dockerfile": false,
        "slug": false,
        "cpu": false,
        "memory": false,
        "disk": false,
        "entrypoint": false,
        "context": false,
        "context_dir": false,
        "gpu": false,
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slug"
            ],
            "properties": {
              "slug": {
                "allOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                  },
                  {
                    "not": {
                      "const": "default"
                    }
                  }
                ]
              },
              "name": {
                "type": "string"
              },
              "entrypoint": {
                "type": "string"
              },
              "image": {},
              "dockerfile": {},
              "cpu": {
                "type": "integer",
                "minimum": 1
              },
              "memory": {
                "type": "integer",
                "minimum": 1
              },
              "disk": {
                "type": "integer",
                "minimum": 1
              },
              "container_runtime": {
                "type": "boolean"
              }
            },
            "oneOf": [
              {
                "required": [
                  "image"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "not": {
                  "required": [
                    "dockerfile"
                  ],
                  "properties": {
                    "dockerfile": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              },
              {
                "required": [
                  "dockerfile"
                ],
                "properties": {
                  "dockerfile": {
                    "type": "string",
                    "pattern": "\\S",
                    "not": {
                      "pattern": "^/|(^|/)\\.\\.($|/)"
                    }
                  }
                },
                "not": {
                  "required": [
                    "image"
                  ],
                  "properties": {
                    "image": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              }
            ]
          }
        },
        "default": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": true
    },
    "sandboxes": false,
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "type"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "cron",
              "webhook",
              "monitor",
              "event"
            ]
          },
          "name": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "agent_name": {
            "type": "string"
          },
          "enabled": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?:[tT][rR][uU][eE]|[fF][aA][lL][sS][eE]|1|0|[yY][eE][sS]|[nN][oO]|[oO][nN]|[oO][fF][fF])$"
              }
            ]
          },
          "session_mode": {
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "fresh",
                  "reuse",
                  "pinned",
                  "keyed"
                ]
              },
              {
                "pattern": "^\\s*(?:[fF][rR][eE][sS][hH]|[rR][eE][uU][sS][eE]|[pP][iI][nN][nN][eE][dD]|[kKK][eE][yY][eE][dD])\\s*$(?![\\s\\S])"
              }
            ]
          },
          "session_key": {
            "type": "string"
          },
          "sessionKey": {
            "type": "string"
          },
          "filter": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "sessionMode": {
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "fresh",
                  "reuse",
                  "pinned",
                  "keyed"
                ]
              },
              {
                "pattern": "^\\s*(?:[fF][rR][eE][sS][hH]|[rR][eE][uU][sS][eE]|[pP][iI][nN][nN][eE][dD]|[kKK][eE][yY][eE][dD])\\s*$(?![\\s\\S])"
              }
            ]
          },
          "session_id": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "prompt_template": {
            "type": "string"
          },
          "cron": {
            "type": "string",
            "minLength": 1
          },
          "schedule": {
            "type": "string",
            "minLength": 1
          },
          "run_at": {
            "type": "string",
            "minLength": 1
          },
          "runAt": {
            "type": "string",
            "minLength": 1
          },
          "timezone": {
            "type": "string"
          },
          "max_lateness": {
            "type": "string",
            "pattern": "^([1-9][0-9]*)(s|m|h|d)$"
          },
          "secret_env": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "secretEnv": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "run": {
            "type": "string",
            "maxLength": 1024
          },
          "mode": {
            "type": "string",
            "enum": [
              "poll",
              "stream"
            ]
          },
          "interval": {
            "type": "string",
            "pattern": "^([1-9][0-9]*)(s|m|h|d)$"
          },
          "expect_event_within": {
            "type": "string",
            "pattern": "^([1-9][0-9]*)(s|m|h|d)$"
          },
          "connector": {
            "type": "string",
            "pattern": "\\S"
          },
          "account": {
            "type": "string",
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "event": {
            "type": "string",
            "pattern": "\\S"
          },
          "config": {
            "type": "object"
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "required": [
                    "session_mode"
                  ],
                  "properties": {
                    "session_mode": {
                      "type": "string",
                      "anyOf": [
                        {
                          "enum": [
                            "pinned"
                          ]
                        },
                        {
                          "pattern": "^\\s*(?:[pP][iI][nN][nN][eE][dD])\\s*$(?![\\s\\S])"
                        }
                      ]
                    }
                  }
                },
                {
                  "not": {
                    "required": [
                      "session_mode"
                    ]
                  },
                  "required": [
                    "sessionMode"
                  ],
                  "properties": {
                    "sessionMode": {
                      "type": "string",
                      "anyOf": [
                        {
                          "enum": [
                            "pinned"
                          ]
                        },
                        {
                          "pattern": "^\\s*(?:[pP][iI][nN][nN][eE][dD])\\s*$(?![\\s\\S])"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "then": {
              "if": {
                "required": [
                  "session_id"
                ]
              },
              "then": {
                "properties": {
                  "session_id": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              "else": {
                "required": [
                  "sessionId"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "prompt"
              ]
            },
            "then": {
              "properties": {
                "prompt": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "else": {
              "required": [
                "prompt_template"
              ],
              "properties": {
                "prompt_template": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "cron"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "cron"
                  ]
                },
                {
                  "required": [
                    "schedule"
                  ]
                },
                {
                  "required": [
                    "run_at"
                  ]
                },
                {
                  "required": [
                    "runAt"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "webhook"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "secret_env"
                  ]
                },
                {
                  "required": [
                    "secretEnv"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "monitor"
                }
              }
            },
            "then": {
              "required": [
                "run",
                "mode"
              ],
              "properties": {
                "run": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "cron": false,
                "schedule": false,
                "run_at": false,
                "runAt": false,
                "timezone": false,
                "secret_env": false,
                "secretEnv": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "event"
                }
              }
            },
            "then": {
              "required": [
                "connector",
                "event"
              ],
              "properties": {
                "cron": false,
                "schedule": false,
                "run_at": false,
                "runAt": false,
                "timezone": false,
                "secret_env": false,
                "secretEnv": false,
                "run": false,
                "mode": false,
                "interval": false,
                "expect_event_within": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "cron",
                    "webhook",
                    "monitor"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "connector": false,
                "account": false,
                "source": false,
                "event": false,
                "config": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "webhook",
                    "monitor",
                    "event"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "max_lateness": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "monitor"
                },
                "mode": {
                  "const": "poll"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "interval"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "monitor"
                },
                "mode": {
                  "const": "stream"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "properties": {
                "interval": false
              }
            }
          }
        ]
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "provider"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "provider": {
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "pipedream",
                  "composio",
                  "mcp",
                  "openapi",
                  "postman",
                  "graphql",
                  "http",
                  "channel"
                ]
              },
              {
                "pattern": "^\\s*(?:[pP][iI][pP][eE][dD][rR][eE][aA][mM]|[cC][oO][mM][pP][oO][sS][iI][oO]|[mM][cC][pP]|[oO][pP][eE][nN][aA][pP][iI]|[pP][oO][sS][tT][mM][aA][nN]|[gG][rR][aA][pP][hH][qQ][lL]|[hH][tT][tT][pP]|[cC][hH][aA][nN][nN][eE][lL])\\s*$(?![\\s\\S])"
              }
            ]
          },
          "app": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "transport": {
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "http",
                  "sse"
                ]
              },
              {
                "pattern": "^\\s*(?:[hH][tT][tT][pP]|[sS][sS][eE])\\s*$(?![\\s\\S])"
              }
            ]
          },
          "spec": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "slack",
                  "teams",
                  "email"
                ]
              },
              {
                "pattern": "^\\s*(?:[sS][lL][aA][cC][kKK]|[tT][eE][aA][mM][sS]|[eE][mM][aA][iI][lL])\\s*$(?![\\s\\S])"
              }
            ]
          },
          "credential": {},
          "authorization_strategy": {
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "project",
                  "user"
                ]
              },
              {
                "pattern": "^\\s*(?:[pP][rR][oO][jJ][eE][cC][tT]|[uU][sS][eE][rR])\\s*$(?![\\s\\S])"
              }
            ],
            "default": "project"
          },
          "agent_scope": {},
          "auth": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "anyOf": [
                  {
                    "enum": [
                      "bearer",
                      "basic",
                      "custom",
                      "api_key",
                      "oauth1",
                      "hmac",
                      "aws_sigv4",
                      "mtls",
                      "none"
                    ]
                  },
                  {
                    "pattern": "^\\s*(?:[bB][eE][aA][rR][eE][rR]|[bB][aA][sS][iI][cC]|[cC][uU][sS][tT][oO][mM]|[aA][pP][iI]_[kKK][eE][yY]|[oO][aA][uU][tT][hH]1|[hH][mM][aA][cC]|[aA][wW][sS]_[sS][iI][gG][vV]4|[mM][tT][lL][sS]|[nN][oO][nN][eE])\\s*$(?![\\s\\S])"
                  }
                ]
              },
              "secret": false
            },
            "additionalProperties": true
          },
          "headers": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$",
              "maxLength": 128
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^[^\\r\\n]*$"
            }
          },
          "policies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "match",
                "action"
              ],
              "properties": {
                "match": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "action": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "always_run",
                        "require_approval",
                        "block"
                      ]
                    },
                    {
                      "pattern": "^\\s*(?:[aA][lL][wW][aA][yY][sS]_[rR][uU][nN]|[rR][eE][qQ][uU][iI][rR][eE]_[aA][pP][pP][rR][oO][vV][aA][lL]|[bB][lL][oO][cC][kKK])\\s*$(?![\\s\\S])"
                    }
                  ]
                }
              }
            }
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "slug": {
                  "const": "kortix_slack"
                }
              }
            },
            "then": {
              "properties": {
                "provider": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "channel"
                      ]
                    },
                    {
                      "pattern": "^\\s*(?:[cC][hH][aA][nN][nN][eE][lL])\\s*$(?![\\s\\S])"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "slug": {
                  "const": "kortix_teams"
                }
              }
            },
            "then": {
              "properties": {
                "provider": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "channel"
                      ]
                    },
                    {
                      "pattern": "^\\s*(?:[cC][hH][aA][nN][nN][eE][lL])\\s*$(?![\\s\\S])"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "slug": {
                  "const": "kortix_email"
                }
              }
            },
            "then": {
              "properties": {
                "provider": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "channel"
                      ]
                    },
                    {
                      "pattern": "^\\s*(?:[cC][hH][aA][nN][nN][eE][lL])\\s*$(?![\\s\\S])"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "slug": {
                  "const": "computer"
                }
              }
            },
            "then": {
              "properties": {
                "provider": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "computer"
                      ]
                    },
                    {
                      "pattern": "^\\s*(?:[cC][oO][mM][pP][uU][tT][eE][rR])\\s*$(?![\\s\\S])"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "pipedream"
                      ]
                    },
                    {
                      "pattern": "^\\s*(?:[pP][iI][pP][eE][dD][rR][eE][aA][mM])\\s*$(?![\\s\\S])"
                    }
                  ]
                }
              }
            },
            "then": {
              "required": [
                "app"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "mcp"
                      ]
                    },
                    {
                      "pattern": "^\\s*(?:[mM][cC][pP])\\s*$(?![\\s\\S])"
                    }
                  ]
                }
              }
            },
            "then": {
              "required": [
                "url"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "graphql"
                      ]
                    },
                    {
                      "pattern": "^\\s*(?:[gG][rR][aA][pP][hH][qQ][lL])\\s*$(?![\\s\\S])"
                    }
                  ]
                }
              }
            },
            "then": {
              "required": [
                "endpoint"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "http"
                      ]
                    },
                    {
                      "pattern": "^\\s*(?:[hH][tT][tT][pP])\\s*$(?![\\s\\S])"
                    }
                  ]
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "base_url"
                  ]
                },
                {
                  "required": [
                    "baseUrl"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "channel"
                      ]
                    },
