{
  "manifest_version": 3,
  "name": "Kortix",
  "version": "1.0.0",
  "description": "Let Kortix agents use this browser, with you watching.",
  "key": "",
  "minimum_chrome_version": "125",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Kortix", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["debugger", "tabs", "tabGroups", "scripting", "storage", "alarms", "sidePanel", "contextMenus"],
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+K", "mac": "Alt+K" }, "description": "Open Kortix" },
    "kortix-stop": { "suggested_key": { "default": "Alt+Shift+K", "mac": "Alt+Shift+K" }, "description": "Stop every agent in this browser" }
  },
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["welcome.html"], "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"] }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://kortix.com/*",
      "https://www.kortix.com/*",
      "https://dev.kortix.com/*",
      "https://staging.kortix.com/*"
    ]
  }
}
