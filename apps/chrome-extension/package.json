{
  "name": "@kortix/chrome-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:dev": "KORTIX_EXTENSION_DEV=1 bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "test": "bun test --timeout ${KORTIX_TEST_TIMEOUT_MS:-15000}"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/chrome": "0.3.4",
    "playwright": "1.63.0",
    "typescript": "^5.4.0"
  }
}
