# The build context here is apps/voice-agent itself (see Dockerfile), and `lk
# agent deploy` uploads this directory to LiveKit's build service. node_modules
# is pnpm-managed: it is a tree of SYMLINKS into the workspace store, so it is
# both large and meaningless outside this machine — the image installs its own
# deps from package.json. Uploading it is the difference between a small context
# and a broken one.
node_modules

# Local dev / test artifacts that have no business in a production image.
.env
.env.*
*.log
scripts/

# Generated by `lk agent create`; it identifies the cloud agent, not the build.
livekit.toml
