{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kortix-ai/suna/blob/dev/apps/capture/schemas/status.schema.json",
  "title": "status.json",
  "description": "<prefix>/<device_id>/status.json, plaintext, written every 60 s. A reader shows the device offline when reportedAtMs is older than 120 s.",
  "type": "object",
  "required": [
    "recording",
    "reason",
    "missingPermissions",
    "pausedUntilMs",
    "audio",
    "sync",
    "lastFrameMs",
    "appVersion",
    "actionsRecording",
    "reportedAtMs"
  ],
  "properties": {
    "recording": {
      "enum": [
        "recording",
        "paused",
        "permission_missing",
        "not_recording"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "missingPermissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pausedUntilMs": {
      "type": [
        "integer",
        "null"
      ]
    },
    "audio": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sync": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "ok",
            "queued",
            "error",
            "off"
          ]
        },
        "pending": {
          "type": "integer"
        },
        "errorClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastUploadMs": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "lastFrameMs": {
      "type": [
        "integer",
        "null"
      ]
    },
    "appVersion": {
      "type": "string"
    },
    "actionsRecording": {
      "type": "boolean"
    },
    "capture": {
      "type": "object",
      "description": "The screen capture rate and size in force: the account policy's recording.interval_ms/max_height, else the device's own settings.",
      "required": [
        "intervalMs",
        "maxHeight"
      ],
      "properties": {
        "intervalMs": {
          "type": "integer",
          "minimum": 500
        },
        "maxHeight": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "policy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "updatedAtMs": {
              "type": "integer"
            },
            "fetchedAtMs": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "reportedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "displays": {
      "type": "array",
      "description": "Every connected display, the focused one first, with the time of its last frame (a static display writes a keep-alive frame every 30 s).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "lastFrameMs"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "main": {
            "type": "boolean"
          },
          "focused": {
            "type": "boolean"
          },
          "lastFrameMs": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "host": {
      "type": "object",
      "description": "The computer. awakeSinceMs: when it last woke from sleep, or when the app started (a gap over 120 s between sync ticks counts as a sleep). A reader counts \"not recording\" time from this moment, never across a sleep.",
      "required": [
        "awakeSinceMs"
      ],
      "properties": {
        "awakeSinceMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
