{
  "name": "kortix",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsgo --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsgo.tsbuildinfo",
    "postinstall": "patch-package",
    "eas-build-post-install": "patch-package",
    "bake:heatmap": "bun scripts/bake-heatmap.ts",
    "bake:liquid-metal": "bun scripts/bake-liquid-metal.ts",
    "bake:maplibre": "bun scripts/bake-maplibre.ts",
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "android:dev": "./scripts/start-android.sh",
    "android:build:local": "npx expo run:android",
    "android:build": "eas build:dev --platform android",
    "android:prebuild": "npx expo prebuild --platform android --clean",
    "android:setup": "./scripts/setup-android.sh",
    "android:emulator": "emulator -avd Kortix_Dev",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "test": "node ../../scripts/test-guard.mjs \"bun test --isolate\""
  },
