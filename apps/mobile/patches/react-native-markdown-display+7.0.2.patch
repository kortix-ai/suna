+/**
+ * Keys are the node's path: its parent's key, its index among its siblings,
+ * and its type. The same markdown always gets the same keys, so a re-parse
+ * (every render) updates the rendered views instead of remounting them.
+ *
+ * @param {Array} nodes
+ * @param {string} prefix
+ */
+function assignKeys(nodes, prefix) {
+  for (let i = 0; i < nodes.length; i++) {
+    const node = nodes[i];
+    node.key = prefix + i + '_' + node.type;
+    assignKeys(node.children, node.key + '-');
+  }
+}
