{
  "expo": {
    "name": "Kortix",
    "slug": "kortix",
    "version": "1.4.4",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon-Light.png",
    "scheme": "kortix",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.kortix.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:kortix.com",
        "applinks:www.kortix.com",
        "applinks:staging.kortix.com",
        "webcredentials:kortix.com"
      ],
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "Kortix needs camera access so you can attach photos to a session.",
        "NSPhotoLibraryUsageDescription": "Kortix needs access to your photo library so you can attach images to a session.",
        "NSSpeechRecognitionUsageDescription": "Kortix turns your speech into text when you dictate a message.",
        "NSMicrophoneUsageDescription": "Kortix uses the microphone when you dictate a message and when you record a video to attach to a session.",
        "NSUserTrackingUsageDescription": "Kortix uses analytics to improve your experience and understand how features are used. For example, we track which AI features are most helpful so we can make the app better for everyone."
      },
      "appleTeamId": "T8G9J33433",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F0F0E9"
      },
      "package": "com.kortix.application",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kortix.com",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "https",
              "host": "www.kortix.com",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "https",
              "host": "staging.kortix.com",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kortix.com",
              "pathPrefix": "/share"
            },
            {
              "scheme": "https",
              "host": "www.kortix.com",
              "pathPrefix": "/share"
            },
            {
              "scheme": "https",
              "host": "staging.kortix.com",
              "pathPrefix": "/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "sounds": [
            "./assets/sounds/kortix/kortix_complete.wav",
            "./assets/sounds/kortix/kortix_attention.wav",
            "./assets/sounds/kortix/kortix_error.wav"
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "imageWidth": 80
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kortix needs camera access so you can attach photos to a session.",
          "photosPermission": "Kortix needs access to your photo library so you can attach images to a session.",
          "microphonePermission": "Kortix uses the microphone when you dictate a message and when you record a video to attach to a session."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kortix uses the microphone when you dictate a message and when you record a video to attach to a session.",
          "speechRecognitionPermission": "Kortix turns your speech into text when you dictate a message.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as", "com.google.android.tts", "com.samsung.android.bixby.agent"]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Kortix uses analytics to improve your experience and understand how features are used. For example, we track which AI features are most helpful so we can make the app better for everyone."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9fca3cff-a291-41c9-88b9-feb8053b990f"
      }
    },
    "owner": "kortix",
    "runtimeVersion": "1.4.4",
    "updates": {
      "url": "https://u.expo.dev/9fca3cff-a291-41c9-88b9-feb8053b990f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
