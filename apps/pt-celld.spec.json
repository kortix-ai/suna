{
  "base_image": "python:3.12-slim",
  "steps": [
    {
      "op": "apt",
      "packages": [
        "ca-certificates",
        "curl",
        "iproute2",
        "procps"
      ]
    },
    {
      "op": "run",
      "cmd": "set -eu; V=v0.3.0; SHA=25385ab57f3193aa4f21b554e9460c80568f151fd1725ec6da8124cf3d216768; curl -fsSL \"https://github.com/denoland/celld/releases/download/$V/celld-x86_64-unknown-linux-gnu.gz\" -o /tmp/c.gz; gunzip -c /tmp/c.gz > /usr/local/bin/celld; rm -f /tmp/c.gz; echo \"$SHA  /usr/local/bin/celld\" | sha256sum -c -; chmod 0755 /usr/local/bin/celld; /usr/local/bin/celld --version | grep -qx \"celld 0.3.0\""
    },
    {
      "op": "copy",
      "dst": "/usr/local/bin/celld-boot",
      "mode": "0755",
      "content_b64": ""
    },
    {
      "op": "env",
      "key": "CELLD_NODES",
      "value": "1"
    },
    {
      "op": "env",
      "key": "CELLD_NOFILE",
      "value": "8192"
    }
  ],
  "entrypoint": "/usr/local/bin/celld-boot",
  "default_cpu": 2,
  "default_ram_mb": 4096,
  "default_disk_gb": 10
}
