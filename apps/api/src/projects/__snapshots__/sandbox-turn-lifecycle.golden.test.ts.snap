exports[`golden SQL: settle backstops settleOpenSandboxTurnsQuery ends every open row with the cause 1`] = `
"UPDATE kortix.session_turns
                SET state = 'ended', end_reason =  runtime_gone , ended_at = now(), updated_at = now()
                     , end_error = CASE WHEN NOT  ( end_error  IS NOT NULL
    AND coalesce( end_error ->>'name', '') NOT IN (  MessageAbortedError  ,   AbortError  ))  THEN  {"name":"SandboxStoppedMidTurn","message":"The sandbox stopped unexpectedly while this turn was running."} ::jsonb ELSE end_error END 
              WHERE sandbox_id =  sb-1 ::uuid
                AND state <> 'ended'"
`;

