exports[`golden SQL: unidentified-cause recorder recordUnidentifiedTurnCause refines the newest bare abort 1`] = `
[
  
"
      UPDATE kortix.session_turns
         SET end_error =  {"name":"SandboxMemoryGuard","message":"sandbox memory at 97% (opencode 513 MB RSS of 3915 MB): turn stopped"} ::jsonb, updated_at = now()
       WHERE turn_token = (
         SELECT t.turn_token
           FROM kortix.session_turns t
          WHERE t.session_id =  sess-1 
            AND t.state = 'ended'
            AND t.end_reason = 'failed'
            AND t.ended_at > now() - make_interval(secs =>  60 )
            AND  ( ses_root ::text IS NULL
                         OR t.opencode_session_id IS NULL
                         OR t.opencode_session_id =  ses_root ) 
          ORDER BY t.ended_at DESC
          LIMIT 1)
         AND NOT  ( end_error  IS NOT NULL
    AND coalesce( end_error ->>'name', '') NOT IN (  MessageAbortedError  ,   AbortError  )) 
      RETURNING turn_token"
,
]
`;

