exports[`golden SQL: turn authority statements abandonSandboxTurn erases the delivering record and settles the ledger 1`] = `
[
  
"
    WITH target AS (
      SELECT s.sandbox_id, s.session_id, s.project_id, s.account_id,
             s.metadata->'activeTurns'-> turn-token  AS turn,
             jsonb_set(
               coalesce(s.metadata, '{}'::jsonb),
               '{activeTurns}',
               coalesce(s.metadata->'activeTurns', '{}'::jsonb) -  turn-token ,
               true) AS metadata
        FROM kortix.session_sandboxes s
       WHERE  s.external_id =  ext-box  
         AND s.metadata->'activeTurns'-> turn-token ->>'token' =  turn-token 
         AND s.metadata->'activeTurns'-> turn-token ->>'state' = 'delivering'
       FOR UPDATE OF s
    )
    UPDATE kortix.session_sandboxes s
       SET metadata = target.metadata,
           updated_at = now()
      FROM target
     WHERE s.sandbox_id = target.sandbox_id
    RETURNING target.sandbox_id, target.session_id, target.project_id, target.account_id,
              target.turn, true AS abandoned"
,
  
"INSERT INTO kortix.session_turns
        (turn_token, session_id, sandbox_id, project_id, account_id,
         opencode_session_id, message_id, state, end_reason, end_error, started_at,
         ended_at, created_at, updated_at)
      VALUES  ( turn-token ,  sess-1 ,  11111111-1111-4111-8111-111111111111 ::uuid,
           22222222-2222-4222-8222-222222222222 ::uuid,  33333333-3333-4333-8333-333333333333 ::uuid,
           ses_root ,  msg_turn_1 , 'ended',  abandoned ,
            ::jsonb,
            2023-11-14T22:13:20.000Z ::timestamptz ,
          now(), now(), now()) 
      ON CONFLICT (turn_token) DO UPDATE SET
            state = 'ended',
            end_reason = EXCLUDED.end_reason,
            end_error = CASE
              WHEN  false 
                THEN coalesce(kortix.session_turns.end_error, EXCLUDED.end_error)
              WHEN EXCLUDED.end_reason = 'failed'
               AND  ( kortix.session_turns.end_error  IS NOT NULL
    AND coalesce( kortix.session_turns.end_error ->>'name', '') NOT IN (  MessageAbortedError  ,   AbortError  )) 
               AND NOT  ( EXCLUDED.end_error  IS NOT NULL
    AND coalesce( EXCLUDED.end_error ->>'name', '') NOT IN (  MessageAbortedError  ,   AbortError  )) 
                THEN kortix.session_turns.end_error
              ELSE EXCLUDED.end_error
            END,
            ended_at = now(),
            opencode_session_id = coalesce(kortix.session_turns.opencode_session_id,
                                           EXCLUDED.opencode_session_id),
            message_id = coalesce(kortix.session_turns.message_id, EXCLUDED.message_id),
            updated_at = now()
      WHERE kortix.session_turns.state <> 'ended'"
,
]
`;

exports[`golden SQL: turn authority statements clearSandboxTurn with a reaper cause ends the ledger row 1`] = `
[
  
"
    WITH target AS (
      SELECT s.sandbox_id, s.session_id, s.project_id, s.account_id,
              CASE
    WHEN jsonb_typeof( s.metadata ) = 'object' THEN  s.metadata 
    ELSE '{}'::jsonb
  END ->'activeTurns'-> turn-token  AS turn,
             jsonb_set(
                CASE
    WHEN jsonb_typeof( s.metadata ) = 'object' THEN  s.metadata 
    ELSE '{}'::jsonb
  END ,
               '{activeTurns}',
               coalesce( CASE
    WHEN jsonb_typeof( s.metadata ) = 'object' THEN  s.metadata 
    ELSE '{}'::jsonb
  END ->'activeTurns', '{}'::jsonb) -  turn-token ,
               true) AS metadata
        FROM kortix.session_sandboxes s
       WHERE s.sandbox_id =  sb-1 ::uuid
         AND s.status = 'active'
         AND  CASE
    WHEN jsonb_typeof( s.metadata ) = 'object' THEN  s.metadata 
    ELSE '{}'::jsonb
  END ->'activeTurns'-> turn-token ->>'token' =  turn-token 
       FOR UPDATE OF s
    )
    UPDATE kortix.session_sandboxes s
       SET metadata = target.metadata,
           deadline_at =  CASE
             WHEN EXISTS (
               SELECT 1
                 FROM jsonb_each(CASE
                   WHEN jsonb_typeof( target.metadata ->'activeTurns') = 'object'
                     THEN  target.metadata ->'activeTurns'
                   ELSE '{}'::jsonb
                 END) remaining
                WHERE remaining.value->>'state' IN ('delivering', 'active'))
             THEN s.deadline_at
             ELSE LEAST(
               s.deadline_at,
               now() + make_interval(secs =>  90 ))
           END ,
           updated_at = now()
      FROM target
     WHERE s.sandbox_id = target.sandbox_id
    RETURNING target.sandbox_id, target.session_id, target.project_id, target.account_id,
              target.turn, true AS cleared"
,
  
"INSERT INTO kortix.session_turns
        (turn_token, session_id, sandbox_id, project_id, account_id,
         opencode_session_id, message_id, state, end_reason, end_error, started_at,
         ended_at, created_at, updated_at)
      VALUES  ( turn-token ,  sess-1 ,  11111111-1111-4111-8111-111111111111 ::uuid,
           22222222-2222-4222-8222-222222222222 ::uuid,  33333333-3333-4333-8333-333333333333 ::uuid,
            ,   , 'ended',  runtime_gone ,
           {"name":"SandboxStoppedMidTurn","message":"The sandbox stopped unexpectedly while this turn was running."} ::jsonb,
           now() ,
          now(), now(), now()) 
      ON CONFLICT (turn_token) DO UPDATE SET
            state = 'ended',
            end_reason = EXCLUDED.end_reason,
            end_error = CASE
              WHEN  true 
                THEN coalesce(kortix.session_turns.end_error, EXCLUDED.end_error)
              WHEN EXCLUDED.end_reason = 'failed'
               AND  ( kortix.session_turns.end_error  IS NOT NULL
    AND coalesce( kortix.session_turns.end_error ->>'name', '') NOT IN (  MessageAbortedError  ,   AbortError  )) 
               AND NOT  ( EXCLUDED.end_error  IS NOT NULL
    AND coalesce( EXCLUDED.end_error ->>'name', '') NOT IN (  MessageAbortedError  ,   AbortError  )) 
                THEN kortix.session_turns.end_error
              ELSE EXCLUDED.end_error
            END,
            ended_at = now(),
            opencode_session_id = coalesce(kortix.session_turns.opencode_session_id,
                                           EXCLUDED.opencode_session_id),
            message_id = coalesce(kortix.session_turns.message_id, EXCLUDED.message_id),
            updated_at = now()
      WHERE kortix.session_turns.state <> 'ended'"
,
]
`;

