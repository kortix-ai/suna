exports[`golden SQL: terminal evidence closeSandboxTurnByMessageId closes by message and settles the ledger 1`] = `
[
  
"
    WITH target AS (
      SELECT s.sandbox_id,
              CASE
    WHEN jsonb_typeof( s.metadata ) = 'object' THEN  s.metadata 
    ELSE '{}'::jsonb
  END  AS metadata
        FROM kortix.session_sandboxes s
       WHERE s.session_id =  sess-1 
         AND s.status IN ('active', 'provisioning')
       FOR UPDATE OF s
    ), selected AS (
      SELECT target.sandbox_id,
             entry.key,
             entry.value->>'token' AS token,
             entry.value
        FROM target
        CROSS JOIN LATERAL jsonb_each(CASE
          WHEN jsonb_typeof(target.metadata->'activeTurns') = 'object'
            THEN target.metadata->'activeTurns'
          ELSE '{}'::jsonb
        END) entry
       WHERE entry.value->>'state' IN ('delivering', 'active')
         AND entry.value->>'messageId' =  msg_turn_1 
    ), next_state AS ( SELECT target.sandbox_id,
             jsonb_set(
               target.metadata,
               '{activeTurns}',
               coalesce((
                 SELECT jsonb_object_agg(entry.key, entry.value)
                   FROM jsonb_each(CASE
                     WHEN jsonb_typeof(target.metadata->'activeTurns') = 'object'
                       THEN target.metadata->'activeTurns'
                     ELSE '{}'::jsonb
                   END) entry
                  WHERE NOT EXISTS (
                    SELECT 1 FROM selected
                     WHERE selected.sandbox_id = target.sandbox_id
                       AND selected.key = entry.key)),
                 '{}'::jsonb),
               true) AS metadata,
             (SELECT coalesce(
                       jsonb_agg(jsonb_build_object(
                         'token', selected.token,
                         'opencodeSessionId', selected.value->>'opencodeSessionId',
                         'messageId', selected.value->>'messageId',
                         'startedAtMs', selected.value->>'startedAtMs'))
                         FILTER (WHERE selected.token IS NOT NULL),
                       '[]'::jsonb)
                FROM selected
               WHERE selected.sandbox_id = target.sandbox_id) AS ended_turns
        FROM target 
       WHERE EXISTS (SELECT 1 FROM selected WHERE selected.sandbox_id = target.sandbox_id)
    )
    UPDATE kortix.session_sandboxes s
       SET metadata = next_state.metadata,
           deadline_at =  CASE
             WHEN EXISTS (
               SELECT 1
                 FROM jsonb_each(CASE
                   WHEN jsonb_typeof( next_state.metadata ->'activeTurns') = 'object'
                     THEN  next_state.metadata ->'activeTurns'
                   ELSE '{}'::jsonb
                 END) remaining
                WHERE remaining.value->>'state' IN ('delivering', 'active'))
             THEN s.deadline_at
             ELSE LEAST(
               s.deadline_at,
               now() + make_interval(secs =>  900 ))
           END ,
           updated_at = now()
      FROM next_state
     WHERE s.sandbox_id = next_state.sandbox_id
    RETURNING next_state.ended_turns, s.session_id, s.sandbox_id, s.project_id, s.account_id"
,
  
"INSERT INTO kortix.session_turns
        (turn_token, session_id, sandbox_id, project_id, account_id,
         opencode_session_id, message_id, state, end_reason, end_error, started_at,
         ended_at, created_at, updated_at)
      VALUES  ( turn-token ,  sess-1 ,  11111111-1111-4111-8111-111111111111 ::uuid,
           22222222-2222-4222-8222-222222222222 ::uuid,  33333333-3333-4333-8333-333333333333 ::uuid,
           ses_root ,  msg_turn_1 , 'ended',  abandoned ,
            ::jsonb,
            2023-11-14T22:13:20.000Z ::timestamptz ,
          now(), now(), now()) 
      ON CONFLICT (turn_token) DO UPDATE SET
            state = 'ended',
            end_reason = EXCLUDED.end_reason,
            end_error = CASE
              WHEN  false 
                THEN coalesce(kortix.session_turns.end_error, EXCLUDED.end_error)
              WHEN EXCLUDED.end_reason = 'failed'
               AND  ( kortix.session_turns.end_error  IS NOT NULL
    AND coalesce( kortix.session_turns.end_error ->>'name', '') NOT IN (  MessageAbortedError  ,   AbortError  )) 
               AND NOT  ( EXCLUDED.end_error  IS NOT NULL
    AND coalesce( EXCLUDED.end_error ->>'name', '') NOT IN (  MessageAbortedError  ,   AbortError  )) 
                THEN kortix.session_turns.end_error
              ELSE EXCLUDED.end_error
            END,
            ended_at = now(),
            opencode_session_id = coalesce(kortix.session_turns.opencode_session_id,
                                           EXCLUDED.opencode_session_id),
            message_id = coalesce(kortix.session_turns.message_id, EXCLUDED.message_id),
            updated_at = now()
      WHERE kortix.session_turns.state <> 'ended'"
,
  
"UPDATE kortix.session_turns
         SET state = 'ended', end_reason =  abandoned , ended_at = now(), updated_at = now()
       WHERE session_id =  sess-1 
         AND message_id =  msg_turn_1 
         AND state <> 'ended'
       RETURNING turn_token"
,
]
`;

exports[`golden SQL: runtime adoption adoptRuntimeSandboxTurn adopts an unseen box-initiated turn 1`] = `
[
  
"
    SELECT
      EXISTS(
        SELECT 1 FROM kortix.session_turns t
         WHERE t.sandbox_id =  sb-1 ::uuid
           AND t.message_id =  msg_adopt ) AS known,
      EXISTS(
        SELECT 1 FROM kortix.session_turns t
         WHERE t.sandbox_id =  sb-1 ::uuid
           AND t.state <> 'ended') AS open"
,
  
"
      UPDATE kortix.session_sandboxes s
         SET metadata = jsonb_set(
                CASE
    WHEN jsonb_typeof( s.metadata ) = 'object' THEN  s.metadata 
    ELSE '{}'::jsonb
  END  - 'lifecycleStopClaim',
               '{activeTurns}',
                CASE
    WHEN jsonb_typeof( s.metadata->'activeTurns' ) = 'object' THEN  s.metadata->'activeTurns' 
    ELSE '{}'::jsonb
  END  || jsonb_build_object(
                  adopt-token ::text,
                 jsonb_build_object(
                   'token',  adopt-token ::text,
                   'state', 'delivering',
                   'opencodeSessionId',  ses_root ::text,
                   'messageId',  msg_adopt ::text,
                   'startedAtMs', floor(extract(epoch from  now() ) * 1000))),
               true),
             deadline_at = GREATEST(
               s.deadline_at,
                now()  + make_interval(secs =>  60 )),
             updated_at = now()
      WHERE  s.sandbox_id =  sb-1 ::uuid 
        AND s.status IN ('active', 'provisioning')
        AND (
          s.metadata->'lifecycleStopClaim' IS NULL
          OR s.metadata->'lifecycleStopClaim'->>'claimedAtMs' !~ '^[0-9]+$'
          OR (s.metadata->'lifecycleStopClaim'->>'claimedAtMs')::bigint
            <= floor(extract(epoch from  now() ) * 1000) -  120000 )
      RETURNING s.sandbox_id, s.session_id, s.project_id, s.account_id, true AS granted"
,
  
"INSERT INTO kortix.session_turns
            (turn_token, session_id, sandbox_id, project_id, account_id,
             opencode_session_id, message_id, state, started_at, created_at, updated_at)
          SELECT  adopt-token , owner.session_id, owner.sandbox_id,
                 owner.project_id, owner.account_id,
                  ses_root ,  msg_adopt , 'delivering',
                  now() , now(), now()
            FROM ( SELECT s.session_id, s.sandbox_id, s.project_id, s.account_id
               FROM kortix.session_sandboxes s
              WHERE s.sandbox_id =  11111111-1111-4111-8111-111111111111 ::uuid
                AND s.status IN ('active', 'provisioning')
                AND s.metadata->'activeTurns'-> adopt-token  IS NOT NULL
              FOR UPDATE ) owner
          ON CONFLICT (turn_token) DO NOTHING"
,
  
"
    UPDATE kortix.session_sandboxes s
       SET metadata = jsonb_set(
             s.metadata,
             ARRAY['activeTurns',  adopt-token ]::text[],
             (s.metadata->'activeTurns'-> adopt-token ) || jsonb_strip_nulls(jsonb_build_object(
               'state', 'active',
               'opencodeSessionId',  ses_root ::text,
               'messageId',  msg_adopt ::text)),
             false),
           deadline_at = GREATEST(
             s.deadline_at,
             now() + make_interval(secs =>  60 )),
           updated_at = now()
     WHERE  s.sandbox_id =  sb-1 ::uuid 
       AND s.status IN ('active', 'provisioning')
       AND s.metadata->'activeTurns'-> adopt-token ->>'token' =  adopt-token 
       AND s.metadata->'activeTurns'-> adopt-token ->>'state' IN ('delivering', 'active')
    RETURNING s.sandbox_id, s.session_id, s.project_id, s.account_id, true AS accepted,
              s.metadata->'activeTurns'-> adopt-token ->>'messageId' AS turn_message_id"
,
]
`;

exports[`golden SQL: runtime adoption adoptRuntimeSandboxTurn refuses a message the ledger already knows 1`] = `
[
  
"
    SELECT
      EXISTS(
        SELECT 1 FROM kortix.session_turns t
         WHERE t.sandbox_id =  sb-1 ::uuid
           AND t.message_id =  msg_adopt ) AS known,
      EXISTS(
        SELECT 1 FROM kortix.session_turns t
         WHERE t.sandbox_id =  sb-1 ::uuid
           AND t.state <> 'ended') AS open"
,
]
`;

