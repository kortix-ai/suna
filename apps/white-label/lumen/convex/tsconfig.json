{
  "compilerOptions": {
    "allowJs": true, "strict": true, "moduleResolution": "Bundler", "jsx": "react-jsx",
    "skipLibCheck": true, "allowSyntheticDefaultImports": true,
    "target": "ESNext", "lib": ["ES2023", "dom", "dom.iterable"], "forceConsistentCasingInFileNames": true,
    "module": "ESNext", "isolatedModules": true, "noEmit": true,
    "types": ["node"]
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
