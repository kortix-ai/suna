# Lumen: Next.js server env (.env.local). `npx convex dev` writes the first
# three. The Kortix operator credential is NOT here: it lives only in the
# Convex deployment (see README → Run it).

# Written by `npx convex dev`.
CONVEX_DEPLOYMENT=anonymous:anonymous-agent
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3030
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3031

# The Kortix API the proxy forwards to. Same value as KORTIX_UPSTREAM in Convex.
KORTIX_UPSTREAM=https://api.kortix.com/v1

# Shared with Convex (`npx convex env set LUMEN_PROXY_SECRET …`): only this
# server can ask Convex for a member's Kortix token. `openssl rand -hex 24`.
LUMEN_PROXY_SECRET=
