{
  "name": "@kortix/desktop-electron",
  "productName": "Kortix",
  "version": "0.1.0",
  "private": true,
  "description": "Kortix desktop shell \u2014 Electron wrapper around the web app",
  "author": "Kortix",
  "repository": "https://github.com/kortix-ai/suna",
  "main": "src/main.js",
  "scripts": {
    "setup": "node scripts/ensure-runtime.js",
    "bundle": "cd ../web && dotenvx run --overload -f .env.${KORTIX_ENV:-dev} -- env NEXT_PUBLIC_BACKEND_URL=/v1 node desktop/build.mjs --web-origin ${KORTIX_WEB_ORIGIN:-https://dev.kortix.com}",
    "prepack": "node scripts/prepack.js",
    "dev": "node scripts/ensure-runtime.js && KORTIX_DESKTOP_URL=http://localhost:3000/projects electron .",
    "dev:dev-env": "node scripts/ensure-runtime.js && KORTIX_DESKTOP_URL=https://dev.kortix.com/projects electron .",
    "dev:prod-env": "node scripts/ensure-runtime.js && KORTIX_DESKTOP_URL=https://kortix.com/projects electron .",
    "pack": "node scripts/prepack.js && node scripts/ensure-runtime.js && electron-builder --dir",
    "dev:macos": "pnpm run pack && open \"$(find dist -maxdepth 2 -name 'Kortix.app' | head -1)\"",
    "build": "node scripts/prepack.js && node scripts/ensure-runtime.js && electron-builder",
    "build:mac": "node scripts/prepack.js && electron-builder --mac",
    "build:win": "node scripts/prepack.js && electron-builder --win",
    "build:linux": "node scripts/prepack.js && electron-builder --linux",
    "dev:bundle": "node scripts/ensure-runtime.js && KORTIX_DESKTOP_BUNDLE_DIR=\"$PWD/../web/out\" KORTIX_DESKTOP_BACKEND_ORIGIN=${KORTIX_DESKTOP_BACKEND_ORIGIN:-https://dev-api.kortix.com} KORTIX_DESKTOP_WEB_ORIGIN=${KORTIX_DESKTOP_WEB_ORIGIN:-https://dev.kortix.com} electron .",
    "test": "bun test src"
  },
  "devDependencies": {
    "electron": "^39.8.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
