{
  "name": "@kortix/sandbox-agent-server",
  "version": "0.1.0",
  "description": "Standalone Kortix compute-node daemon and runtime supervisor.",
  "type": "module",
  "main": "src/main.ts",
  "engines": {
    "bun": "1.3.11"
  },
  "bin": {
    "kortixd": "./dist/kortixd"
  },
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "build": "bash scripts/build.sh",
    "start": "./dist/kortixd run",
    "typecheck": "bun tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.12.25",
    "node-forge": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0",
    "@types/node-forge": "^1.3.11"
  }
}
