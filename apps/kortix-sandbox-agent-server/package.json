{
  "name": "kortixd",
  "version": "0.1.0",
  "description": "kortixd — the Kortix sandbox agent daemon and its self-update manager (single compiled binary).",
  "type": "module",
  "main": "src/main.ts",
  "engines": {
    "bun": "1.3.11"
  },
  "bin": {
    "kortixd": "./dist/kortixd",
    "kortix-agent": "./dist/kortix-agent"
  },
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "build": "bash scripts/build.sh",
    "start": "./dist/kortixd",
    "typecheck": "bun tsc --noEmit",
    "lint": "eslint src",
    "test:architecture": "node --test scripts/check-architecture.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "hono": "^4.12.25",
    "node-forge": "^1.4.0",
    "tar": "^7.5.22",
    "typebox": "1.3.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.11",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "eslint-plugin-project-structure": "3.14.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.70.0",
    "ws": "8.21.3"
  }
}
