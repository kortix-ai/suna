{
  "name": "pt-agent-daemon",
  "version": "0.1.0",
  "base_image": "node:22-slim",
  "steps": [
    {
      "op": "apt",
      "packages": [
        "ca-certificates",
        "curl",
        "git",
        "ripgrep",
        "procps"
      ]
    },
    {
      "op": "copy",
      "dst": "/opt/agent-daemon/server.js",
      "mode": "0644",
      "content_b64": ""
    },
    {
      "op": "copy",
      "dst": "/usr/local/bin/agent-daemon",
      "mode": "0755",
      "content_b64": ""
    },
    {
      "op": "env",
      "key": "WORK_ROOT",
      "value": "/work"
    },
    {
      "op": "env",
      "key": "PORT",
      "value": "7070"
    }
  ],
  "entrypoint": "/usr/local/bin/agent-daemon",
  "default_cpu": 2,
  "default_ram_mb": 2048,
  "default_disk_gb": 20
}
