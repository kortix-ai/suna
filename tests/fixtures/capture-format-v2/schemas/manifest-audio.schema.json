{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kortix-ai/capture/blob/main/apps/recorder/schemas/manifest-audio.schema.json",
  "title": "Audio segment manifest",
  "description": "<prefix>/<device_id>/<YYYY>/<MM>/<DD>/<start_ms>-a<audio_id>.manifest.json. objects.audio is AAC-LC in M4A.",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "device_id",
    "start_ms",
    "end_ms",
    "app_version",
    "created_at_ms",
    "encryption",
    "privacy",
    "objects",
    "audio_id",
    "sources",
    "transcript"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "kind": {
      "const": "audio"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+$"
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0
    },
    "app_version": {
      "type": "string"
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "encryption": {
      "$ref": "#/$defs/encryption"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "objects": {
      "type": "object",
      "required": [
        "audio"
      ],
      "properties": {
        "audio": {
          "$ref": "#/$defs/object"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/object"
      }
    },
    "audio_id": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "enum": [
          "microphone",
          "system",
          "file"
        ]
      }
    },
    "content_type": {
      "type": "string"
    },
    "codec": {
      "type": "string"
    },
    "sample_rate": {
      "type": "integer"
    },
    "channels": {
      "type": "integer"
    },
    "audio_name": {
      "type": "string"
    },
    "pii_redacted": {
      "type": "boolean"
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start_ms",
          "end_ms",
          "text"
        ],
        "properties": {
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "object": {
      "type": "object",
      "required": [
        "key",
        "size",
        "sha256",
        "plain_size",
        "plain_sha256"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plain_size": {
          "type": "integer",
          "minimum": 0
        },
        "plain_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "asset": {
      "type": "string",
      "pattern": "^(sha256-)?[0-9a-f]{64}\\.[a-z0-9]+$"
    },
    "encryption": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "alg",
            "key_id"
          ],
          "properties": {
            "alg": {
              "type": "string"
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "privacy": {
      "type": "object",
      "required": [
        "redact_pii",
        "mode"
      ],
      "properties": {
        "redact_pii": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "off",
            "patterns",
            "model"
          ]
        }
      }
    }
  }
}
