{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kortix-ai/capture/blob/main/apps/recorder/schemas/issuer-credentials.schema.json",
  "title": "Credential response",
  "description": "200 response of POST <issuer>/v1/capture/credentials (Authorization: Bearer <device_token>). 401/403 means the device must sign in again.",
  "type": "object",
  "required": [
    "endpoint",
    "bucket",
    "region",
    "prefix",
    "device_id",
    "access_key_id",
    "secret_access_key",
    "session_token",
    "expires_at_ms"
  ],
  "properties": {
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "bucket": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string"
    },
    "prefix": {
      "type": "string"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+$"
    },
    "access_key_id": {
      "type": "string",
      "minLength": 1
    },
    "secret_access_key": {
      "type": "string",
      "minLength": 1
    },
    "session_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "path_style": {
      "type": "boolean"
    }
  }
}
